    "plan": "python3 scripts/run_story_video.py --mode plan",
    "preview": "python3 scripts/run_story_video.py --mode preview",
    "render": "python3 scripts/run_story_video.py --mode render"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  }
