{
  "name": "monalisa-film",
  "version": "1.0.0",
  "private": true,
  "description": "中文故事 → 3:4 竖屏手绘故事动画（文字 → 线稿 → 彩色 三层揭示 / 翻书转场）",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
