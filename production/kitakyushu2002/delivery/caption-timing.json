[
  {
    "start": 0.713178947368421,
    "end": 2.325978947368421,
    "text": "二〇〇二年三月，"
  },
  {
    "start": 2.599494736842105,
    "end": 3.665263157894737,
    "text": "日本北九州。"
  },
  {
    "start": 3.938778947368421,
    "end": 4.448084210526315,
    "text": "深夜，"
  },
  {
    "start": 4.7216,
    "end": 6.466442105263157,
    "text": "一名十七岁的少女，"
  },
  {
    "start": 6.683368421052631,
    "end": 8.730021052631578,
    "text": "从一间普通公寓逃了出来——"
  },
  {
    "start": 9.0224,
    "end": 10.80496842105263,
    "text": "她之前逃出去过一次，"
  },
  {
    "start": 11.078484210526316,
    "end": 12.059368421052628,
    "text": "又被抓了回去。"
  },
  {
    "start": 12.332884210526316,
    "end": 13.06854736842105,
    "text": "这一次，"
  },
  {
    "start": 13.266610526315787,
    "end": 15.190652631578946,
    "text": "她跑到祖父家求助，"
  },
  {
    "start": 15.454736842105262,
    "end": 16.878905263157893,
    "text": "终于有人信了她。"
  },
  {
    "start": 17.15242105263158,
    "end": 17.661726315789473,
    "text": "第二天，"
  },
  {
    "start": 17.92581052631579,
    "end": 18.99157894736842,
    "text": "警方进入公寓，"
  },
  {
    "start": 19.265094736842105,
    "end": 20.62324210526316,
    "text": "表面看不出异常；"
  },
  {
    "start": 20.887326315789476,
    "end": 22.141726315789473,
    "text": "控制这里的两人——"
  },
  {
    "start": 22.415242105263157,
    "end": 23.141473684210524,
    "text": "松永太，"
  },
  {
    "start": 23.414989473684212,
    "end": 25.85776842105263,
    "text": "和内缘妻子绪方纯子，"
  },
  {
    "start": 26.131284210526317,
    "end": 26.9424,
    "text": "随即被捕。"
  },
  {
    "start": 27.215915789473684,
    "end": 28.234526315789473,
    "text": "调查越深，"
  },
  {
    "start": 28.508042105263158,
    "end": 29.0928,
    "text": "失踪、"
  },
  {
    "start": 29.366315789473685,
    "end": 30.894231578947366,
    "text": "死亡和监禁，"
  },
  {
    "start": 31.158315789473683,
    "end": 32.4976,
    "text": "越连成同一条线——"
  },
  {
    "start": 32.76168421052631,
    "end": 34.308463157894735,
    "text": "这间普通的屋子里，"
  },
  {
    "start": 34.59141052631579,
    "end": 36.09103157894737,
    "text": "藏着七条人命。"
  },
  {
    "start": 37.29364210526316,
    "end": 39.32143157894737,
    "text": "要理解这间屋子里发生的事，"
  },
  {
    "start": 39.519494736842105,
    "end": 40.77389473684211,
    "text": "得回到九十年代。"
  },
  {
    "start": 41.03797894736842,
    "end": 43.01861052631579,
    "text": "松永太早年做生意，"
  },
  {
    "start": 43.28269473684211,
    "end": 44.442778947368424,
    "text": "后来卷入诈骗，"
  },
  {
    "start": 44.71629473684211,
    "end": 45.45195789473684,
    "text": "欠下债务、"
  },
  {
    "start": 45.716042105263156,
    "end": 46.64033684210526,
    "text": "四处逃亡。"
  },
  {
    "start": 46.904421052631584,
    "end": 48.347452631578946,
    "text": "他最擅长的，"
  },
  {
    "start": 48.62096842105264,
    "end": 50.13002105263158,
    "text": "是操纵人心："
  },
  {
    "start": 50.40353684210527,
    "end": 51.43157894736842,
    "text": "用谎言、"
  },
  {
    "start": 51.59191578947369,
    "end": 53.50652631578947,
    "text": "威胁和经济压力，"
  },
  {
    "start": 53.78004210526316,
    "end": 57.88277894736842,
    "text": "把身边的人一步步变成自己的工具。"
  },
  {
    "start": 58.14686315789474,
    "end": 59.99545263157895,
    "text": "绪方纯子和她的家人，"
  },
  {
    "start": 60.18408421052632,
    "end": 61.91006315789474,
    "text": "就是这样一点一点，"
  },
  {
    "start": 62.14585263157895,
    "end": 63.85296842105264,
    "text": "落进他的控制之中。"
  },
  {
    "start": 65.05557894736843,
    "end": 66.50804210526316,
    "text": "从一九九六年起，"
  },
  {
    "start": 66.80985263157895,
    "end": 69.3658105263158,
    "text": "绪方的家人接连被带进这间公寓。"
  },
  {
    "start": 69.6298947368421,
    "end": 71.63882105263158,
    "text": "一九九六年到一九九八年，"
  },
  {
    "start": 71.91233684210526,
    "end": 74.03444210526317,
    "text": "多名受害者在这里遭到监禁、"
  },
  {
    "start": 74.14762105263158,
    "end": 75.336,
    "text": "虐待和控制——"
  },
  {
    "start": 75.60008421052632,
    "end": 77.65616842105263,
    "text": "原本应该保护彼此的亲人，"
  },
  {
    "start": 77.85423157894738,
    "end": 79.61793684210527,
    "text": "被恐惧推向绝境："
  },
  {
    "start": 79.89145263157896,
    "end": 80.64597894736842,
    "text": "不敢对视，"
  },
  {
    "start": 80.91006315789474,
    "end": 81.62686315789475,
    "text": "不敢多问，"
  },
  {
    "start": 81.89094736842105,
    "end": 84.75814736842105,
    "text": "连求救的机会都被一点点剥夺。"
  },
  {
    "start": 85.08825263157895,
    "end": 86.43696842105263,
    "text": "这不是家庭纠纷，"
  },
  {
    "start": 86.71991578947369,
    "end": 89.16269473684211,
    "text": "是持续的恐吓与暴力。"
  },
  {
    "start": 90.36530526315791,
    "end": 93.77953684210527,
    "text": "这场悲剧最终吞噬了绪方家的多名成员。"
  },
  {
    "start": 94.04362105263158,
    "end": 96.62787368421053,
    "text": "死亡在封闭的屋子里接连发生，"
  },
  {
    "start": 96.90138947368422,
    "end": 98.66509473684211,
    "text": "外界却几乎一无所知。"
  },
  {
    "start": 98.9386105263158,
    "end": 100.3722105263158,
    "text": "直到少女逃出、"
  },
  {
    "start": 100.56084210526316,
    "end": 101.47570526315789,
    "text": "开口陈述，"
  },
  {
    "start": 101.74922105263158,
    "end": 102.99418947368422,
    "text": "警方才把失踪、"
  },
  {
    "start": 103.16395789473685,
    "end": 105.63503157894738,
    "text": "死亡和监禁串成一条线："
  },
  {
    "start": 105.89911578947368,
    "end": 107.37987368421054,
    "text": "七名死亡受害者，"
  },
  {
    "start": 107.5968,
    "end": 109.0304,
    "text": "大多是绪方的家人，"
  },
  {
    "start": 109.30391578947369,
    "end": 110.73751578947369,
    "text": "其中包括两名孩子；"
  },
  {
    "start": 111.00160000000001,
    "end": 112.96336842105264,
    "text": "六起被认定为谋杀，"
  },
  {
    "start": 113.23688421052631,
    "end": 116.2597052631579,
    "text": "另一起被认定为伤害致死。"
  },
  {
    "start": 117.44345263157895,
    "end": 118.69785263157895,
    "text": "二〇〇三年十月，"
  },
  {
    "start": 118.97136842105263,
    "end": 119.96168421052631,
    "text": "审判开始；"
  },
  {
    "start": 120.2352,
    "end": 121.30096842105263,
    "text": "因为案情太多，"
  },
  {
    "start": 121.57448421052632,
    "end": 123.42307368421052,
    "text": "此后每周开庭一次。"
  },
  {
    "start": 123.68715789473684,
    "end": 124.29077894736842,
    "text": "法庭上，"
  },
  {
    "start": 124.5642947368421,
    "end": 125.90357894736842,
    "text": "两人的责任成为焦点："
  },
  {
    "start": 126.17709473684211,
    "end": 127.45978947368421,
    "text": "绪方承认参与，"
  },
  {
    "start": 127.73330526315789,
    "end": 128.78964210526317,
    "text": "但辩护方强调，"
  },
  {
    "start": 129.04429473684212,
    "end": 131.2607157894737,
    "text": "她长期受到松永的支配和虐待；"
  },
  {
    "start": 131.53423157894736,
    "end": 134.81642105263157,
    "text": "松永则否认自己应为全部罪行负责。"
  },
  {
    "start": 135.08993684210526,
    "end": 136.30661052631578,
    "text": "二〇〇五年九月，"
  },
  {
    "start": 136.46694736842105,
    "end": 138.46644210526316,
    "text": "一审双双判处死刑；"
  },
  {
    "start": 138.7493894736842,
    "end": 139.35301052631579,
    "text": "两年后，"
  },
  {
    "start": 139.6170947368421,
    "end": 142.6634947368421,
    "text": "二审改判绪方无期徒刑。"
  },
  {
    "start": 143.8661052631579,
    "end": 145.4789052631579,
    "text": "二〇一一年十二月，"
  },
  {
    "start": 145.74298947368422,
    "end": 147.3274947368421,
    "text": "最高法院维持原判："
  },
  {
    "start": 147.6010105263158,
    "end": 149.44016842105265,
    "text": "松永太死刑确定，"
  },
  {
    "start": 149.7136842105263,
    "end": 152.25077894736842,
    "text": "绪方纯子无期徒刑确定。"
  },
  {
    "start": 152.5242947368421,
    "end": 153.0618947368421,
    "text": "回头看，"
  },
  {
    "start": 153.3259789473684,
    "end": 156.6741894736842,
    "text": "这间公寓和普通住宅没有任何区别——"
  },
  {
    "start": 156.9477052631579,
    "end": 159.70172631578947,
    "text": "最可怕的不是某个瞬间的暴行，"
  },
  {
    "start": 159.97524210526316,
    "end": 164.3514947368421,
    "text": "而是六年的恐怖就藏在日常的表象之下。"
  },
  {
    "start": 164.61557894736842,
    "end": 165.17204210526316,
    "text": "恐惧、"
  },
  {
    "start": 165.43612631578947,
    "end": 167.62425263157894,
    "text": "谎言和被剥夺的选择，"
  },
  {
    "start": 167.83174736842105,
    "end": 169.86896842105264,
    "text": "筑成了一座没有铁栏的牢笼。"
  },
  {
    "start": 170.14248421052633,
    "end": 172.05709473684212,
    "text": "判决确定了刑期，"
  },
  {
    "start": 172.2362947368421,
    "end": 174.0,
    "text": "却换不回七条生命。"
  }
]