[
  {
    "start": 0.6,
    "end": 3.277419354838709,
    "text": "一九四七年一月十五日，"
  },
  {
    "start": 3.686021505376344,
    "end": 4.417204301075269,
    "text": "洛杉矶。"
  },
  {
    "start": 5.06236559139785,
    "end": 7.750537634408602,
    "text": "一位母亲带着孩子经过空地，"
  },
  {
    "start": 8.331182795698926,
    "end": 10.782795698924732,
    "text": "最初以为路边躺着一个假人。"
  },
  {
    "start": 11.10537634408602,
    "end": 12.610752688172042,
    "text": "走近后，"
  },
  {
    "start": 12.6752688172043,
    "end": 13.513978494623654,
    "text": "她才发现，"
  },
  {
    "start": 13.686021505376344,
    "end": 16.13763440860215,
    "text": "那是一名遇害的年轻女子。"
  },
  {
    "start": 16.63225806451613,
    "end": 18.39569892473118,
    "text": "更反常的是，"
  },
  {
    "start": 18.61075268817204,
    "end": 20.202150537634406,
    "text": "现场没有血迹。"
  },
  {
    "start": 21.083870967741937,
    "end": 22.632258064516126,
    "text": "警方由此判断："
  },
  {
    "start": 22.825806451612905,
    "end": 25.10537634408602,
    "text": "这里很可能不是第一现场。"
  },
  {
    "start": 25.944086021505377,
    "end": 26.524731182795698,
    "text": "是谁，"
  },
  {
    "start": 26.782795698924733,
    "end": 28.07311827956989,
    "text": "把她带到了这里？"
  },
  {
    "start": 29.292903225806448,
    "end": 33.034838709677416,
    "text": "警方把指纹通过照片传真传给联邦调查局。"
  },
  {
    "start": 33.034838709677416,
    "end": 34.99182795698924,
    "text": "五十六分钟后，"
  },
  {
    "start": 34.99182795698924,
    "end": 36.454193548387096,
    "text": "身份得到确认。"
  },
  {
    "start": 36.454193548387096,
    "end": 38.84129032258064,
    "text": "她叫伊丽莎白·肖特，"
  },
  {
    "start": 38.84129032258064,
    "end": 40.045591397849456,
    "text": "二十二岁。"
  },
  {
    "start": 40.045591397849456,
    "end": 43.37892473118279,
    "text": "她曾因求职等原因留下指纹，"
  },
  {
    "start": 43.37892473118279,
    "end": 45.24989247311827,
    "text": "旧档案认出了她，"
  },
  {
    "start": 45.24989247311827,
    "end": 46.97032258064516,
    "text": "却指不出凶手。"
  },
  {
    "start": 46.97032258064516,
    "end": 50.454193548387096,
    "text": "媒体后来给她起了一个名字："
  },
  {
    "start": 50.454193548387096,
    "end": 51.87354838709677,
    "text": "黑色大丽花。"
  },
  {
    "start": 51.87354838709677,
    "end": 54.56172043010752,
    "text": "可一个耸动的称呼，"
  },
  {
    "start": 54.56172043010752,
    "end": 58.15311827956989,
    "text": "并不能解释她遭遇了什么。"
  },
  {
    "start": 58.15311827956989,
    "end": 61.034838709677416,
    "text": "调查必须回到她失踪前的生活。"
  },
  {
    "start": 62.114838709677414,
    "end": 64.20086021505375,
    "text": "警方当年的调查通告，"
  },
  {
    "start": 64.20086021505375,
    "end": 67.79225806451612,
    "text": "把目光锁定在一月九日至十五日。"
  },
  {
    "start": 67.79225806451612,
    "end": 69.44817204301074,
    "text": "通告记录，"
  },
  {
    "start": 69.44817204301074,
    "end": 73.44817204301074,
    "text": "她一月九日曾在比尔特莫尔酒店下车。"
  },
  {
    "start": 73.44817204301074,
    "end": 75.14709677419354,
    "text": "此后几天，"
  },
  {
    "start": 75.14709677419354,
    "end": 76.41591397849461,
    "text": "她去了哪里，"
  },
  {
    "start": 76.41591397849461,
    "end": 77.31913978494623,
    "text": "见过谁？"
  },
  {
    "start": 77.31913978494623,
    "end": 79.94279569892473,
    "text": "时间线出现了空白。"
  },
  {
    "start": 79.94279569892473,
    "end": 82.05032258064516,
    "text": "要找到凶手，"
  },
  {
    "start": 82.05032258064516,
    "end": 84.97505376344085,
    "text": "首先要把这段行踪接起来，"
  },
  {
    "start": 84.97505376344085,
    "end": 87.23311827956988,
    "text": "而不是用传闻填满它。"
  },
  {
    "start": 88.31311827956989,
    "end": 89.20559139784946,
    "text": "随后，"
  },
  {
    "start": 89.4421505376344,
    "end": 92.10881720430108,
    "text": "一封匿名信带来了新的希望。"
  },
  {
    "start": 92.62494623655914,
    "end": 94.25935483870968,
    "text": "它会不会来自凶手？"
  },
  {
    "start": 94.92602150537634,
    "end": 98.10881720430108,
    "text": "联邦调查局尝试比对信上的指纹，"
  },
  {
    "start": 98.3668817204301,
    "end": 100.53892473118279,
    "text": "却没有在档案中找到匹配。"
  },
  {
    "start": 101.16258064516128,
    "end": 102.77548387096775,
    "text": "信是谁寄的，"
  },
  {
    "start": 102.94752688172042,
    "end": 104.13032258064516,
    "text": "依然不能确定。"
  },
  {
    "start": 105.09806451612903,
    "end": 105.97978494623655,
    "text": "另一方面，"
  },
  {
    "start": 106.25935483870967,
    "end": 109.4636559139785,
    "text": "警方怀疑作案者可能具有解剖技能，"
  },
  {
    "start": 109.74322580645162,
    "end": 111.57118279569892,
    "text": "于是扩大调查范围。"
  },
  {
    "start": 111.85075268817204,
    "end": 113.09806451612903,
    "text": "但怀疑，"
  },
  {
    "start": 113.2916129032258,
    "end": 114.53892473118279,
    "text": "并不是证据。"
  },
  {
    "start": 115.80172043010752,
    "end": 118.80172043010752,
    "text": "调查人员核查嫌疑人的记录，"
  },
  {
    "start": 118.95225806451613,
    "end": 121.42537634408602,
    "text": "并在美国多地展开访谈。"
  },
  {
    "start": 121.61892473118279,
    "end": 123.55440860215053,
    "text": "线索不断增加，"
  },
  {
    "start": 123.68344086021504,
    "end": 125.53290322580645,
    "text": "却始终没能把身份、"
  },
  {
    "start": 125.64043010752688,
    "end": 129.81247311827957,
    "text": "地点和作案过程连成一条可证实的链。"
  },
  {
    "start": 130.26408602150536,
    "end": 131.4898924731183,
    "text": "几十年里，"
  },
  {
    "start": 131.55440860215054,
    "end": 133.68344086021506,
    "text": "各种理论轮番出现。"
  },
  {
    "start": 133.98451612903224,
    "end": 135.96301075268818,
    "text": "有人指向某个嫌疑人，"
  },
  {
    "start": 136.02752688172043,
    "end": 137.68344086021506,
    "text": "有人声称已经破案。"
  },
  {
    "start": 138.0705376344086,
    "end": 140.11354838709676,
    "text": "可一个讲得通的故事，"
  },
  {
    "start": 140.2210752688172,
    "end": 142.672688172043,
    "text": "不等于一个被证明的事实。"
  },
  {
    "start": 144.06451612903226,
    "end": 146.32258064516128,
    "text": "我们能够确认的，"
  },
  {
    "start": 146.32258064516128,
    "end": 147.29032258064515,
    "text": "是她的身份、"
  },
  {
    "start": 147.29032258064515,
    "end": 149.3763440860215,
    "text": "遗体被发现的日期，"
  },
  {
    "start": 149.3763440860215,
    "end": 151.54838709677418,
    "text": "以及调查留下的缺口。"
  },
  {
    "start": 151.54838709677418,
    "end": 155.67741935483872,
    "text": "按照联邦调查局公布的案件资料，"
  },
  {
    "start": 155.67741935483872,
    "end": 157.91397849462365,
    "text": "这起谋杀案仍未侦破。"
  },
  {
    "start": 157.91397849462365,
    "end": 162.81720430107526,
    "text": "悬念没有一个可以负责任写下的凶手名字。"
  },
  {
    "start": 162.81720430107526,
    "end": 165.11827956989248,
    "text": "而在所有传说之前，"
  },
  {
    "start": 165.11827956989248,
    "end": 166.94623655913978,
    "text": "应该被记住的，"
  },
  {
    "start": 166.94623655913978,
    "end": 169.0752688172043,
    "text": "是一个真实的人。"
  },
  {
    "start": 169.0752688172043,
    "end": 171.16129032258064,
    "text": "伊丽莎白·肖特。"
  },
  {
    "start": 171.16129032258064,
    "end": 174.0,
    "text": "她只有二十二岁。"
  }
]