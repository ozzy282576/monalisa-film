[
  {
    "start": 0.657230454777721,
    "end": 2.727065235905297,
    "text": "一个曼哈顿的建筑咨询师，"
  },
  {
    "start": 2.8319877363311194,
    "end": 5.111667518310339,
    "text": "办公室就在帝国大厦旁边，"
  },
  {
    "start": 5.21659001873616,
    "end": 6.637812979049565,
    "text": "有老婆有孩子，"
  },
  {
    "start": 6.733197070345767,
    "end": 8.478725941066259,
    "text": "邻居眼里的模范爸爸。"
  },
  {
    "start": 8.574110032362459,
    "end": 9.480258899676375,
    "text": "三十年，"
  },
  {
    "start": 9.575642990972577,
    "end": 11.044557996934083,
    "text": "没人怀疑过他。"
  },
  {
    "start": 11.149480497359905,
    "end": 12.465780957247487,
    "text": "最后让他暴露的，"
  },
  {
    "start": 12.484857775506729,
    "end": 15.012536194856073,
    "text": "是一个扔进垃圾桶的披萨盒。"
  },
  {
    "start": 15.107920286152275,
    "end": 17.74052120592744,
    "text": "这就是美国近年最离奇的悬案："
  },
  {
    "start": 17.778674842445923,
    "end": 20.439890989609946,
    "text": "长岛吉尔戈海滩连环案。"
  },
  {
    "start": 20.53527508090615,
    "end": 22.33803440640436,
    "text": "今天一口气讲清楚："
  },
  {
    "start": 22.433418497700565,
    "end": 23.85464145801397,
    "text": "他是怎么隐藏的，"
  },
  {
    "start": 23.950025549310173,
    "end": 25.371248509623573,
    "text": "又是怎么栽的。"
  },
  {
    "start": 26.508478964401295,
    "end": 27.576780786918754,
    "text": "先说他是谁。"
  },
  {
    "start": 27.672164878214957,
    "end": 28.778620337250896,
    "text": "雷克斯·赫曼，"
  },
  {
    "start": 28.874004428547096,
    "end": 30.056767160619998,
    "text": "身高一米九三，"
  },
  {
    "start": 30.133074433656958,
    "end": 31.87860330437745,
    "text": "长岛马萨皮夸公园人，"
  },
  {
    "start": 31.98352580480327,
    "end": 33.7004394481349,
    "text": "住的还是他小时候的房子。"
  },
  {
    "start": 33.80536194856072,
    "end": 34.349051268949076,
    "text": "白天，"
  },
  {
    "start": 34.358589678078694,
    "end": 35.6844285470959,
    "text": "他坐火车进曼哈顿，"
  },
  {
    "start": 35.7798126383921,
    "end": 38.18349173905638,
    "text": "给纽约的大楼做建筑合规咨询；"
  },
  {
    "start": 38.27887583035258,
    "end": 38.83210355987055,
    "text": "晚上，"
  },
  {
    "start": 38.908410832907514,
    "end": 40.577632430591045,
    "text": "回家陪妻子和两个孩子。"
  },
  {
    "start": 40.67301652188725,
    "end": 42.704697666496344,
    "text": "可就在这栋房子的地下室里，"
  },
  {
    "start": 42.80962016692216,
    "end": 45.1465304036791,
    "text": "藏着一份写于两千年的文件。"
  },
  {
    "start": 45.241914494975305,
    "end": 45.93821836143758,
    "text": "它是什么，"
  },
  {
    "start": 46.033602452733774,
    "end": 47.035135411343894,
    "text": "我们后面再说。"
  },
  {
    "start": 48.11513541134389,
    "end": 49.11666836995401,
    "text": "他盯上的，"
  },
  {
    "start": 49.21205246125021,
    "end": 52.092652018395505,
    "text": "大多是在网上招揽客人的年轻女性。"
  },
  {
    "start": 52.321573837506385,
    "end": 53.809565661727135,
    "text": "套路极其固定："
  },
  {
    "start": 53.885872934764095,
    "end": 55.62186339635497,
    "text": "等老婆孩子出门旅行，"
  },
  {
    "start": 55.679093851132684,
    "end": 57.54862204053824,
    "text": "用一次性手机联系对方，"
  },
  {
    "start": 57.70123658661216,
    "end": 58.63600068131494,
    "text": "约到家里。"
  },
  {
    "start": 58.9030761369443,
    "end": 60.52460568897973,
    "text": "地下室里发生了什么，"
  },
  {
    "start": 60.71537387157213,
    "end": 61.80275251234883,
    "text": "只有他知道。"
  },
  {
    "start": 61.936290240163515,
    "end": 62.413210696644526,
    "text": "之后，"
  },
  {
    "start": 62.489517969681486,
    "end": 64.28273888605008,
    "text": "他用粗麻布把她们裹住，"
  },
  {
    "start": 64.435353432124,
    "end": 66.11411343893715,
    "text": "沿着海洋公园大道，"
  },
  {
    "start": 66.30488162152955,
    "end": 68.86117526826776,
    "text": "弃置在吉尔戈海滩的荒草丛里。"
  },
  {
    "start": 68.86117526826776,
    "end": 71.05500936808039,
    "text": "从一九九三到二零一零，"
  },
  {
    "start": 71.37931527848748,
    "end": 72.27592573667178,
    "text": "十七年，"
  },
  {
    "start": 72.37130982796798,
    "end": 73.87837847044796,
    "text": "至少八名受害者。"
  },
  {
    "start": 73.95468574348493,
    "end": 74.81314256515074,
    "text": "更过分的是，"
  },
  {
    "start": 74.92760347470619,
    "end": 76.85436211888945,
    "text": "他还用其中一名受害者的手机，"
  },
  {
    "start": 76.85436211888945,
    "end": 79.04819621870209,
    "text": "打电话挑衅她的家人。"
  },
  {
    "start": 80.27604156021121,
    "end": 81.41111224663601,
    "text": "二零一零年底，"
  },
  {
    "start": 81.5064963379322,
    "end": 83.63356157383751,
    "text": "四名受害者的遗体被发现，"
  },
  {
    "start": 83.72894566513371,
    "end": 84.7209402146142,
    "text": "全美震动。"
  },
  {
    "start": 84.81632430591041,
    "end": 85.94185658320559,
    "text": "可十几年过去，"
  },
  {
    "start": 86.0467790836314,
    "end": 87.33446431613014,
    "text": "警方一无所获。"
  },
  {
    "start": 87.43938681655595,
    "end": 88.79384091296203,
    "text": "转机在二零二二年："
  },
  {
    "start": 88.89876341338784,
    "end": 90.49167773803441,
    "text": "新任局长成立专案组，"
  },
  {
    "start": 90.58706182933061,
    "end": 92.49474365525464,
    "text": "把老卷宗翻了个底朝天。"
  },
  {
    "start": 92.59966615568047,
    "end": 94.98426843808551,
    "text": "一条被忽略的目击证词跳了出来："
  },
  {
    "start": 95.0796525293817,
    "end": 98.36086526997104,
    "text": "嫌疑人开一辆墨绿色的雪佛兰雪崩皮卡。"
  },
  {
    "start": 98.46578777039687,
    "end": 99.65808891159939,
    "text": "数据库一查，"
  },
  {
    "start": 99.76301141202521,
    "end": 100.42116164196901,
    "text": "车主，"
  },
  {
    "start": 100.52608414239482,
    "end": 101.47038664622721,
    "text": "正是赫曼。"
  },
  {
    "start": 101.56577073752342,
    "end": 102.53868846874468,
    "text": "接下来一年半，"
  },
  {
    "start": 102.63407256004088,
    "end": 103.6832975642991,
    "text": "警察没抓人，"
  },
  {
    "start": 103.6832975642991,
    "end": 106.44466700732414,
    "text": "而是悄悄跟着他——等他扔垃圾。"
  },
  {
    "start": 107.57235905297225,
    "end": 109.71850110713677,
    "text": "二零二三年一月二十六日，"
  },
  {
    "start": 109.8234236075626,
    "end": 111.04433997615398,
    "text": "曼哈顿街头，"
  },
  {
    "start": 111.1492624765798,
    "end": 112.54187020950435,
    "text": "赫曼吃完披萨，"
  },
  {
    "start": 112.64679270993017,
    "end": 114.57355135411345,
    "text": "随手把盒子扔进垃圾桶。"
  },
  {
    "start": 114.70708908192813,
    "end": 116.51938681655596,
    "text": "跟踪小组马上捡走。"
  },
  {
    "start": 116.62430931698178,
    "end": 118.08368591381367,
    "text": "披萨边上的DNA，"
  },
  {
    "start": 118.15045477772101,
    "end": 121.34582183614376,
    "text": "和当年麻布上留下的一根男性毛发比对："
  },
  {
    "start": 121.45074433656958,
    "end": 124.56026571282575,
    "text": "百分之九十九点九六的北美人都能排除，"
  },
  {
    "start": 124.65564980412196,
    "end": 125.6190291262136,
    "text": "他不能。"
  },
  {
    "start": 125.72395162663942,
    "end": 126.7064077669903,
    "text": "七月十三日，"
  },
  {
    "start": 126.81133026741611,
    "end": 128.1276307273037,
    "text": "他在办公室门口被捕。"
  },
  {
    "start": 128.2230148185999,
    "end": 129.9685436893204,
    "text": "警方搜了他家十二天，"
  },
  {
    "start": 130.0639277806166,
    "end": 131.61868846874466,
    "text": "拉走了地下室的硬盘。"
  },
  {
    "start": 131.71407256004088,
    "end": 132.7537591551695,
    "text": "后来在里面，"
  },
  {
    "start": 132.84914324646567,
    "end": 135.20513030148186,
    "text": "翻出一份两千年建的Word文档，"
  },
  {
    "start": 135.30051439277807,
    "end": 136.70266053483223,
    "text": "一份作案清单："
  },
  {
    "start": 136.79804462612844,
    "end": 138.50541986033045,
    "text": "问题栏写着毛发、"
  },
  {
    "start": 138.60080395162663,
    "end": 139.2494157724408,
    "text": "DNA、"
  },
  {
    "start": 139.35433827286664,
    "end": 139.98387327542156,
    "text": "指纹；"
  },
  {
    "start": 140.07925736671777,
    "end": 141.08079032532788,
    "text": "目标栏写着，"
  },
  {
    "start": 141.1857128257537,
    "end": 142.3207835121785,
    "text": "小个子好。"
  },
  {
    "start": 143.45801396695623,
    "end": 144.96508260943622,
    "text": "清单里还有一条："
  },
  {
    "start": 145.07000510986205,
    "end": 146.7964571623233,
    "text": "行动前要睡够，"
  },
  {
    "start": 146.8918412536195,
    "end": 148.2653721682848,
    "text": "太累会出问题。"
  },
  {
    "start": 148.37029466871064,
    "end": 149.56259580991315,
    "text": "写下这句话的人，"
  },
  {
    "start": 149.65797990120936,
    "end": 151.4416624084483,
    "text": "第二天照常去上班。"
  },
  {
    "start": 151.53704649974452,
    "end": 153.21580650655767,
    "text": "二零二六年四月八日，"
  },
  {
    "start": 153.31119059785388,
    "end": 155.57179356157386,
    "text": "六十二岁的赫曼当庭认罪，"
  },
  {
    "start": 155.66717765287007,
    "end": 157.12655424970194,
    "text": "承认了八起命案；"
  },
  {
    "start": 157.23147675012777,
    "end": 157.78470447964574,
    "text": "六月，"
  },
  {
    "start": 157.8133197070346,
    "end": 159.12008175779255,
    "text": "被判终身监禁，"
  },
  {
    "start": 159.16777380344067,
    "end": 159.97853857945836,
    "text": "不得假释。"
  },
  {
    "start": 160.0834610798842,
    "end": 161.2662238119571,
    "text": "三十年的悬案，"
  },
  {
    "start": 161.3711463123829,
    "end": 163.99420882302846,
    "text": "最后输给了一块没吃完的披萨边。"
  },
  {
    "start": 164.08959291432467,
    "end": 164.56651337080567,
    "text": "所以，"
  },
  {
    "start": 164.63328223471302,
    "end": 166.4646567876001,
    "text": "别再迷信什么完美犯罪。"
  },
  {
    "start": 166.56957928802592,
    "end": 168.24833929483904,
    "text": "你扔掉的每一样东西，"
  },
  {
    "start": 168.33418497700563,
    "end": 169.4597172543008,
    "text": "都在替你说话。"
  },
  {
    "start": 169.55510134559702,
    "end": 170.14648271163347,
    "text": "你觉得，"
  },
  {
    "start": 170.14648271163347,
    "end": 171.34832226196562,
    "text": "是他太蠢，"
  },
  {
    "start": 171.3864758984841,
    "end": 172.92215976835294,
    "text": "还是警察太耐心？"
  },
  {
    "start": 173.02708226877877,
    "end": 174.0,
    "text": "评论区聊聊。"
  }
]