{
 "N01": {
  "duration": 25.97,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.08,
    "text": "一个曼哈顿的建筑咨询师",
    "chars_per_second": 5.7
   },
   {
    "i": 1,
    "start": 2.43,
    "end": 4.58,
    "text": "办公室就在帝国大厦旁边",
    "chars_per_second": 5.12
   },
   {
    "i": 2,
    "start": 4.93,
    "end": 6.18,
    "text": "有老婆有孩子",
    "chars_per_second": 4.8
   },
   {
    "i": 3,
    "start": 6.52,
    "end": 8.11,
    "text": "邻居眼里的模范爸爸",
    "chars_per_second": 5.66
   },
   {
    "i": 4,
    "start": 8.45,
    "end": 9.16,
    "text": "三十年",
    "chars_per_second": 4.23
   },
   {
    "i": 5,
    "start": 9.5,
    "end": 10.8,
    "text": "没人怀疑过他",
    "chars_per_second": 4.62
   },
   {
    "i": 6,
    "start": 11.15,
    "end": 12.29,
    "text": "最后让他暴露的",
    "chars_per_second": 6.14
   },
   {
    "i": 7,
    "start": 12.55,
    "end": 14.96,
    "text": "是一个扔进垃圾桶的披萨盒",
    "chars_per_second": 4.98
   },
   {
    "i": 8,
    "start": 15.3,
    "end": 17.82,
    "text": "这就是美国近年最离奇的悬案",
    "chars_per_second": 5.16
   },
   {
    "i": 9,
    "start": 18.1,
    "end": 20.65,
    "text": "长岛吉尔戈海滩连环案",
    "chars_per_second": 3.92
   },
   {
    "i": 10,
    "start": 20.99,
    "end": 22.64,
    "text": "今天一口气讲清楚",
    "chars_per_second": 4.85
   },
   {
    "i": 11,
    "start": 22.98,
    "end": 24.23,
    "text": "他是怎么隐藏的",
    "chars_per_second": 5.6
   },
   {
    "i": 12,
    "start": 24.57,
    "end": 25.97,
    "text": "又是怎么栽的",
    "chars_per_second": 4.29
   }
  ]
 },
 "N02": {
  "duration": 21.58,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.03,
    "text": "先说他是谁",
    "chars_per_second": 5.68
   },
   {
    "i": 1,
    "start": 1.37,
    "end": 2.29,
    "text": "雷克斯·赫曼",
    "chars_per_second": 5.43
   },
   {
    "i": 2,
    "start": 2.63,
    "end": 3.63,
    "text": "身高一米九三",
    "chars_per_second": 6.0
   },
   {
    "i": 3,
    "start": 3.95,
    "end": 5.54,
    "text": "长岛马萨皮夸公园人",
    "chars_per_second": 5.66
   },
   {
    "i": 4,
    "start": 5.89,
    "end": 7.45,
    "text": "住的还是他小时候的房子",
    "chars_per_second": 7.05
   },
   {
    "i": 5,
    "start": 7.8,
    "end": 8.13,
    "text": "白天",
    "chars_per_second": 6.06
   },
   {
    "i": 6,
    "start": 8.38,
    "end": 9.53,
    "text": "他坐火车进曼哈顿",
    "chars_per_second": 6.96
   },
   {
    "i": 7,
    "start": 9.87,
    "end": 12.15,
    "text": "给纽约的大楼做建筑合规咨询",
    "chars_per_second": 5.7
   },
   {
    "i": 8,
    "start": 12.49,
    "end": 12.83,
    "text": "晚上",
    "chars_per_second": 5.88
   },
   {
    "i": 9,
    "start": 13.15,
    "end": 14.66,
    "text": "回家陪妻子和两个孩子",
    "chars_per_second": 6.62
   },
   {
    "i": 10,
    "start": 15.0,
    "end": 16.89,
    "text": "可就在这栋房子的地下室里",
    "chars_per_second": 6.35
   },
   {
    "i": 11,
    "start": 17.24,
    "end": 19.45,
    "text": "藏着一份写于两千年的文件",
    "chars_per_second": 5.43
   },
   {
    "i": 12,
    "start": 19.79,
    "end": 20.28,
    "text": "它是什么",
    "chars_per_second": 8.16
   },
   {
    "i": 13,
    "start": 20.62,
    "end": 21.58,
    "text": "我们后面再说",
    "chars_per_second": 6.25
   }
  ]
 },
 "N03": {
  "duration": 32.525,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.83,
    "text": "他盯上的",
    "chars_per_second": 5.88
   },
   {
    "i": 1,
    "start": 1.17,
    "end": 4.02,
    "text": "大多是在网上招揽客人的年轻女性",
    "chars_per_second": 5.26
   },
   {
    "i": 2,
    "start": 4.37,
    "end": 5.79,
    "text": "套路极其固定",
    "chars_per_second": 4.23
   },
   {
    "i": 3,
    "start": 6.13,
    "end": 7.74,
    "text": "等老婆孩子出门旅行",
    "chars_per_second": 5.59
   },
   {
    "i": 4,
    "start": 8.04,
    "end": 9.74,
    "text": "用一次性手机联系对方",
    "chars_per_second": 5.88
   },
   {
    "i": 5,
    "start": 10.09,
    "end": 10.81,
    "text": "约到家里",
    "chars_per_second": 5.56
   },
   {
    "i": 6,
    "start": 11.15,
    "end": 12.88,
    "text": "地下室里发生了什么",
    "chars_per_second": 5.2
   },
   {
    "i": 7,
    "start": 13.23,
    "end": 14.25,
    "text": "只有他知道",
    "chars_per_second": 4.9
   },
   {
    "i": 8,
    "start": 14.6,
    "end": 14.84,
    "text": "之后",
    "chars_per_second": 8.33
   },
   {
    "i": 9,
    "start": 15.12,
    "end": 16.82,
    "text": "他用粗麻布把她们裹住",
    "chars_per_second": 5.88
   },
   {
    "i": 10,
    "start": 17.18,
    "end": 18.69,
    "text": "沿着海洋公园大道",
    "chars_per_second": 5.3
   },
   {
    "i": 11,
    "start": 19.03,
    "end": 21.54,
    "text": "弃置在吉尔戈海滩的荒草丛里",
    "chars_per_second": 5.18
   },
   {
    "i": 12,
    "start": 21.88,
    "end": 23.96,
    "text": "从一九九三到二零一零",
    "chars_per_second": 4.81
   },
   {
    "i": 13,
    "start": 24.25,
    "end": 25.1,
    "text": "十七年",
    "chars_per_second": 3.53
   },
   {
    "i": 14,
    "start": 25.44,
    "end": 26.81,
    "text": "至少八名受害者",
    "chars_per_second": 5.11
   },
   {
    "i": 15,
    "start": 27.15,
    "end": 27.86,
    "text": "更过分的是",
    "chars_per_second": 7.04
   },
   {
    "i": 16,
    "start": 28.17,
    "end": 30.24,
    "text": "他还用其中一名受害者的手机",
    "chars_per_second": 6.28
   },
   {
    "i": 17,
    "start": 30.53,
    "end": 32.52,
    "text": "打电话挑衅她的家人",
    "chars_per_second": 4.51
   }
  ]
 },
 "N04": {
  "duration": 27.495,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.1,
    "text": "二零一零年底",
    "chars_per_second": 6.32
   },
   {
    "i": 1,
    "start": 1.44,
    "end": 3.43,
    "text": "四名受害者的遗体被发现",
    "chars_per_second": 5.53
   },
   {
    "i": 2,
    "start": 3.77,
    "end": 4.57,
    "text": "全美震动",
    "chars_per_second": 5.0
   },
   {
    "i": 3,
    "start": 4.91,
    "end": 5.85,
    "text": "可十几年过去",
    "chars_per_second": 6.38
   },
   {
    "i": 4,
    "start": 6.2,
    "end": 7.31,
    "text": "警方一无所获",
    "chars_per_second": 5.41
   },
   {
    "i": 5,
    "start": 7.66,
    "end": 8.84,
    "text": "转机在二零二二年",
    "chars_per_second": 6.78
   },
   {
    "i": 6,
    "start": 9.19,
    "end": 10.62,
    "text": "新任局长成立专案组",
    "chars_per_second": 6.29
   },
   {
    "i": 7,
    "start": 10.96,
    "end": 12.72,
    "text": "把老卷宗翻了个底朝天",
    "chars_per_second": 5.68
   },
   {
    "i": 8,
    "start": 13.07,
    "end": 15.33,
    "text": "一条被忽略的目击证词跳了出来",
    "chars_per_second": 6.19
   },
   {
    "i": 9,
    "start": 15.67,
    "end": 18.87,
    "text": "嫌疑人开一辆墨绿色的雪佛兰雪崩皮卡",
    "chars_per_second": 5.31
   },
   {
    "i": 10,
    "start": 19.22,
    "end": 20.23,
    "text": "数据库一查",
    "chars_per_second": 4.95
   },
   {
    "i": 11,
    "start": 20.58,
    "end": 21.03,
    "text": "车主",
    "chars_per_second": 4.44
   },
   {
    "i": 12,
    "start": 21.38,
    "end": 22.13,
    "text": "正是赫曼",
    "chars_per_second": 5.33
   },
   {
    "i": 13,
    "start": 22.47,
    "end": 23.25,
    "text": "接下来一年半",
    "chars_per_second": 7.69
   },
   {
    "i": 14,
    "start": 23.59,
    "end": 24.45,
    "text": "警察没抓人",
    "chars_per_second": 5.81
   },
   {
    "i": 15,
    "start": 24.69,
    "end": 25.96,
    "text": "而是悄悄跟着他",
    "chars_per_second": 5.51
   },
   {
    "i": 16,
    "start": 26.3,
    "end": 27.5,
    "text": "等他扔垃圾",
    "chars_per_second": 4.18
   }
  ]
 },
 "N05": {
  "duration": 36.48,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.15,
    "text": "二零二三年一月二十六日",
    "chars_per_second": 5.47
   },
   {
    "i": 1,
    "start": 2.5,
    "end": 3.54,
    "text": "曼哈顿街头",
    "chars_per_second": 4.81
   },
   {
    "i": 2,
    "start": 3.89,
    "end": 5.11,
    "text": "赫曼吃完披萨",
    "chars_per_second": 4.92
   },
   {
    "i": 3,
    "start": 5.46,
    "end": 7.24,
    "text": "随手把盒子扔进垃圾桶",
    "chars_per_second": 5.62
   },
   {
    "i": 4,
    "start": 7.62,
    "end": 9.28,
    "text": "跟踪小组马上捡走",
    "chars_per_second": 4.82
   },
   {
    "i": 5,
    "start": 9.63,
    "end": 10.92,
    "text": "披萨边上的DNA",
    "chars_per_second": 6.2
   },
   {
    "i": 6,
    "start": 11.23,
    "end": 14.34,
    "text": "和当年麻布上留下的一根男性毛发比对",
    "chars_per_second": 5.47
   },
   {
    "i": 7,
    "start": 14.69,
    "end": 17.71,
    "text": "百分之九十九点九六的北美人都能排除",
    "chars_per_second": 5.63
   },
   {
    "i": 8,
    "start": 18.05,
    "end": 18.82,
    "text": "他不能",
    "chars_per_second": 3.9
   },
   {
    "i": 9,
    "start": 19.17,
    "end": 19.96,
    "text": "七月十三日",
    "chars_per_second": 6.33
   },
   {
    "i": 10,
    "start": 20.31,
    "end": 21.45,
    "text": "他在办公室门口被捕",
    "chars_per_second": 7.89
   },
   {
    "i": 11,
    "start": 21.79,
    "end": 23.38,
    "text": "警方搜了他家十二天",
    "chars_per_second": 5.66
   },
   {
    "i": 12,
    "start": 23.72,
    "end": 25.11,
    "text": "拉走了地下室的硬盘",
    "chars_per_second": 6.47
   },
   {
    "i": 13,
    "start": 25.45,
    "end": 26.3,
    "text": "后来在里面",
    "chars_per_second": 5.88
   },
   {
    "i": 14,
    "start": 26.64,
    "end": 28.87,
    "text": "翻出一份两千年建的Word文档",
    "chars_per_second": 6.73
   },
   {
    "i": 15,
    "start": 29.21,
    "end": 30.44,
    "text": "一份作案清单",
    "chars_per_second": 4.88
   },
   {
    "i": 16,
    "start": 30.78,
    "end": 32.33,
    "text": "问题栏写着毛发",
    "chars_per_second": 4.52
   },
   {
    "i": 17,
    "start": 32.67,
    "end": 33.11,
    "text": "DNA",
    "chars_per_second": 6.82
   },
   {
    "i": 18,
    "start": 33.46,
    "end": 33.88,
    "text": "指纹",
    "chars_per_second": 4.76
   },
   {
    "i": 19,
    "start": 34.22,
    "end": 35.03,
    "text": "目标栏写着",
    "chars_per_second": 6.17
   },
   {
    "i": 20,
    "start": 35.38,
    "end": 36.48,
    "text": "小个子好",
    "chars_per_second": 3.64
   }
  ]
 },
 "N06": {
  "duration": 32.08,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.49,
    "text": "清单里还有一条",
    "chars_per_second": 5.22
   },
   {
    "i": 1,
    "start": 1.84,
    "end": 3.41,
    "text": "行动前要睡够",
    "chars_per_second": 3.82
   },
   {
    "i": 2,
    "start": 3.75,
    "end": 4.95,
    "text": "太累会出问题",
    "chars_per_second": 5.0
   },
   {
    "i": 3,
    "start": 5.3,
    "end": 6.31,
    "text": "写下这句话的人",
    "chars_per_second": 6.93
   },
   {
    "i": 4,
    "start": 6.65,
    "end": 8.28,
    "text": "第二天照常去上班",
    "chars_per_second": 4.91
   },
   {
    "i": 5,
    "start": 8.62,
    "end": 10.14,
    "text": "二零二六年四月八日",
    "chars_per_second": 5.92
   },
   {
    "i": 6,
    "start": 10.48,
    "end": 12.61,
    "text": "六十二岁的赫曼当庭认罪",
    "chars_per_second": 5.16
   },
   {
    "i": 7,
    "start": 12.95,
    "end": 14.24,
    "text": "承认了八起命案",
    "chars_per_second": 5.43
   },
   {
    "i": 8,
    "start": 14.59,
    "end": 14.93,
    "text": "六月",
    "chars_per_second": 5.88
   },
   {
    "i": 9,
    "start": 15.2,
    "end": 16.33,
    "text": "被判终身监禁",
    "chars_per_second": 5.31
   },
   {
    "i": 10,
    "start": 16.62,
    "end": 17.23,
    "text": "不得假释",
    "chars_per_second": 6.56
   },
   {
    "i": 11,
    "start": 17.58,
    "end": 18.58,
    "text": "三十年的悬案",
    "chars_per_second": 6.0
   },
   {
    "i": 12,
    "start": 18.93,
    "end": 21.44,
    "text": "最后输给了一块没吃完的披萨边",
    "chars_per_second": 5.58
   },
   {
    "i": 13,
    "start": 21.78,
    "end": 22.04,
    "text": "所以",
    "chars_per_second": 7.69
   },
   {
    "i": 14,
    "start": 22.35,
    "end": 24.03,
    "text": "别再迷信什么完美犯罪",
    "chars_per_second": 5.95
   },
   {
    "i": 15,
    "start": 24.38,
    "end": 25.9,
    "text": "你扔掉的每一样东西",
    "chars_per_second": 5.92
   },
   {
    "i": 16,
    "start": 26.23,
    "end": 27.17,
    "text": "都在替你说话",
    "chars_per_second": 6.38
   },
   {
    "i": 17,
    "start": 27.51,
    "end": 27.89,
    "text": "你觉得",
    "chars_per_second": 7.89
   },
   {
    "i": 18,
    "start": 28.13,
    "end": 29.15,
    "text": "是他太蠢",
    "chars_per_second": 3.92
   },
   {
    "i": 19,
    "start": 29.43,
    "end": 30.8,
    "text": "还是警察太耐心",
    "chars_per_second": 5.11
   },
   {
    "i": 20,
    "start": 31.15,
    "end": 32.08,
    "text": "评论区聊聊",
    "chars_per_second": 5.38
   }
  ]
 }
}