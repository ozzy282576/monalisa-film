{
 "N01": {
  "duration": 24.16,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.6,
    "text": "狂犬病可怕在",
    "chars_per_second": 4.11
   },
   {
    "i": 1,
    "start": 1.94,
    "end": 3.22,
    "text": "症状一旦出现",
    "chars_per_second": 4.69
   },
   {
    "i": 2,
    "start": 3.56,
    "end": 4.88,
    "text": "几乎没有回头路",
    "chars_per_second": 5.3
   },
   {
    "i": 3,
    "start": 5.23,
    "end": 7.02,
    "text": "恐水等神经症状之后",
    "chars_per_second": 5.03
   },
   {
    "i": 4,
    "start": 7.36,
    "end": 8.85,
    "text": "患者可能走向死亡",
    "chars_per_second": 5.37
   },
   {
    "i": 5,
    "start": 9.19,
    "end": 10.14,
    "text": "疫苗出现前",
    "chars_per_second": 5.26
   },
   {
    "i": 6,
    "start": 10.52,
    "end": 12.08,
    "text": "人们试过烧灼伤口",
    "chars_per_second": 5.13
   },
   {
    "i": 7,
    "start": 12.42,
    "end": 13.65,
    "text": "却没有可靠保护",
    "chars_per_second": 5.69
   },
   {
    "i": 8,
    "start": 14.0,
    "end": 15.01,
    "text": "改写这一切的",
    "chars_per_second": 5.94
   },
   {
    "i": 9,
    "start": 15.35,
    "end": 16.23,
    "text": "不是一位医生",
    "chars_per_second": 6.82
   },
   {
    "i": 10,
    "start": 16.58,
    "end": 17.77,
    "text": "而是一位化学家",
    "chars_per_second": 5.88
   },
   {
    "i": 11,
    "start": 18.12,
    "end": 19.1,
    "text": "路易·巴斯德",
    "chars_per_second": 5.1
   },
   {
    "i": 12,
    "start": 19.44,
    "end": 20.65,
    "text": "可他即将面对的",
    "chars_per_second": 5.79
   },
   {
    "i": 13,
    "start": 20.99,
    "end": 22.14,
    "text": "不是一道理论题",
    "chars_per_second": 6.09
   },
   {
    "i": 14,
    "start": 22.49,
    "end": 24.16,
    "text": "而是一个九岁男孩",
    "chars_per_second": 4.79
   }
  ]
 },
 "N02": {
  "duration": 28.485,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.48,
    "text": "从一八八零年起",
    "chars_per_second": 5.22
   },
   {
    "i": 1,
    "start": 1.82,
    "end": 4.6,
    "text": "巴斯德团队在巴黎研究狂犬病",
    "chars_per_second": 4.68
   },
   {
    "i": 2,
    "start": 4.95,
    "end": 8.03,
    "text": "他们先让病原在兔之间连续传代",
    "chars_per_second": 4.55
   },
   {
    "i": 3,
    "start": 8.37,
    "end": 10.78,
    "text": "得到潜伏期稳定的固定病毒",
    "chars_per_second": 4.98
   },
   {
    "i": 4,
    "start": 11.12,
    "end": 13.94,
    "text": "再把感染兔的脊髓悬在干燥空气中",
    "chars_per_second": 5.32
   },
   {
    "i": 5,
    "start": 14.25,
    "end": 15.12,
    "text": "令毒力下降",
    "chars_per_second": 5.75
   },
   {
    "i": 6,
    "start": 15.46,
    "end": 15.77,
    "text": "随后",
    "chars_per_second": 6.45
   },
   {
    "i": 7,
    "start": 16.12,
    "end": 18.93,
    "text": "团队按由弱到强的次序给动物接种",
    "chars_per_second": 5.34
   },
   {
    "i": 8,
    "start": 19.28,
    "end": 20.48,
    "text": "狗的实验给了希望",
    "chars_per_second": 6.67
   },
   {
    "i": 9,
    "start": 20.83,
    "end": 22.23,
    "text": "但病原肉眼看不见",
    "chars_per_second": 5.71
   },
   {
    "i": 10,
    "start": 22.58,
    "end": 24.13,
    "text": "巴斯德又不是执业医生",
    "chars_per_second": 6.45
   },
   {
    "i": 11,
    "start": 24.48,
    "end": 26.79,
    "text": "把尚无人体证据的方法用于人",
    "chars_per_second": 5.63
   },
   {
    "i": 12,
    "start": 27.1,
    "end": 28.48,
    "text": "后果无法预料",
    "chars_per_second": 4.33
   }
  ]
 },
 "N03": {
  "duration": 25.565,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.76,
    "text": "一八八五年七月六日",
    "chars_per_second": 5.59
   },
   {
    "i": 1,
    "start": 2.1,
    "end": 5.16,
    "text": "阿尔萨斯的约瑟夫·迈斯特被母亲带到巴黎",
    "chars_per_second": 5.88
   },
   {
    "i": 2,
    "start": 5.51,
    "end": 6.02,
    "text": "他九岁",
    "chars_per_second": 5.88
   },
   {
    "i": 3,
    "start": 6.22,
    "end": 9.18,
    "text": "两天前被一只据报患狂犬病的狗咬了十四处",
    "chars_per_second": 6.42
   },
   {
    "i": 4,
    "start": 9.37,
    "end": 10.32,
    "text": "巴斯德写道",
    "chars_per_second": 5.26
   },
   {
    "i": 5,
    "start": 10.67,
    "end": 11.33,
    "text": "孩子的死亡看起来不可避免",
    "chars_per_second": 18.18
   },
   {
    "i": 6,
    "start": 11.54,
    "end": 13.67,
    "text": "自己是在极度焦虑中作出决定",
    "chars_per_second": 6.1
   },
   {
    "i": 7,
    "start": 14.05,
    "end": 16.12,
    "text": "他没有亲手注射",
    "chars_per_second": 3.38
   },
   {
    "i": 8,
    "start": 16.47,
    "end": 17.41,
    "text": "在医生支持下",
    "chars_per_second": 6.38
   },
   {
    "i": 9,
    "start": 17.75,
    "end": 18.83,
    "text": "儿科医生雅克",
    "chars_per_second": 5.56
   },
   {
    "i": 10,
    "start": 19.17,
    "end": 22.35,
    "text": "约瑟夫·格朗谢执行第一针",
    "chars_per_second": 3.46
   },
   {
    "i": 11,
    "start": 22.69,
    "end": 23.54,
    "text": "没有随机对照",
    "chars_per_second": 7.06
   },
   {
    "i": 12,
    "start": 23.89,
    "end": 25.57,
    "text": "也没有今天的伦理审查",
    "chars_per_second": 5.97
   }
  ]
 },
 "N04": {
  "duration": 24.055,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.05,
    "text": "随后十天",
    "chars_per_second": 4.44
   },
   {
    "i": 1,
    "start": 1.4,
    "end": 4.75,
    "text": "迈斯特接受十几次由弱到强的制剂",
    "chars_per_second": 4.48
   },
   {
    "i": 2,
    "start": 5.09,
    "end": 7.86,
    "text": "不同史料记为十三针或十四剂",
    "chars_per_second": 4.69
   },
   {
    "i": 3,
    "start": 8.21,
    "end": 9.77,
    "text": "原理简单也冒险",
    "chars_per_second": 4.49
   },
   {
    "i": 4,
    "start": 10.12,
    "end": 11.69,
    "text": "先给免疫系统时间",
    "chars_per_second": 5.1
   },
   {
    "i": 5,
    "start": 12.03,
    "end": 14.36,
    "text": "再让它迎向更强的病毒材料",
    "chars_per_second": 5.15
   },
   {
    "i": 6,
    "start": 14.71,
    "end": 16.45,
    "text": "迈斯特最终没有发病",
    "chars_per_second": 5.17
   },
   {
    "i": 7,
    "start": 16.78,
    "end": 21.01,
    "text": "但一个成功病例不能替代今天的临床试验",
    "chars_per_second": 4.26
   },
   {
    "i": 8,
    "start": 21.35,
    "end": 22.01,
    "text": "它提示",
    "chars_per_second": 4.55
   },
   {
    "i": 9,
    "start": 22.23,
    "end": 24.05,
    "text": "暴露之后仍可能追上疾病",
    "chars_per_second": 6.03
   }
  ]
 },
 "N05": {
  "duration": 25.065,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.9,
    "text": "消息传开",
    "chars_per_second": 5.26
   },
   {
    "i": 1,
    "start": 1.24,
    "end": 3.9,
    "text": "被动物咬伤的人从多国赶到巴黎",
    "chars_per_second": 5.26
   },
   {
    "i": 2,
    "start": 4.25,
    "end": 5.74,
    "text": "到一八八六年十一月",
    "chars_per_second": 6.04
   },
   {
    "i": 3,
    "start": 6.08,
    "end": 8.36,
    "text": "约两千五百人接受过这种治疗",
    "chars_per_second": 5.7
   },
   {
    "i": 4,
    "start": 8.71,
    "end": 10.9,
    "text": "到巴斯德一八九五年去世时",
    "chars_per_second": 5.48
   },
   {
    "i": 5,
    "start": 11.24,
    "end": 12.28,
    "text": "人数接近两万",
    "chars_per_second": 5.77
   },
   {
    "i": 6,
    "start": 12.63,
    "end": 14.52,
    "text": "需求推动建立专门机构",
    "chars_per_second": 5.29
   },
   {
    "i": 7,
    "start": 14.87,
    "end": 16.45,
    "text": "一八八七年募款启动",
    "chars_per_second": 5.7
   },
   {
    "i": 8,
    "start": 16.79,
    "end": 18.53,
    "text": "一八八八年十一月十四日",
    "chars_per_second": 6.32
   },
   {
    "i": 9,
    "start": 18.87,
    "end": 21.06,
    "text": "巴斯德研究所在巴黎正式开放",
    "chars_per_second": 5.94
   },
   {
    "i": 10,
    "start": 21.4,
    "end": 22.46,
    "text": "一次紧急救治",
    "chars_per_second": 5.66
   },
   {
    "i": 11,
    "start": 22.76,
    "end": 25.07,
    "text": "变成持续的公共卫生事业",
    "chars_per_second": 4.77
   }
  ]
 },
 "N06": {
  "duration": 33.03,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.62,
    "text": "今天",
    "chars_per_second": 4.26
   },
   {
    "i": 1,
    "start": 0.97,
    "end": 3.83,
    "text": "狂犬病仍会夺走数万人的生命",
    "chars_per_second": 4.55
   },
   {
    "i": 2,
    "start": 4.18,
    "end": 6.48,
    "text": "儿童承受的负担尤其重",
    "chars_per_second": 4.35
   },
   {
    "i": 3,
    "start": 6.82,
    "end": 9.1,
    "text": "但现代暴露后预防已不同",
    "chars_per_second": 4.82
   },
   {
    "i": 4,
    "start": 9.44,
    "end": 10.65,
    "text": "细胞培养疫苗",
    "chars_per_second": 4.96
   },
   {
    "i": 5,
    "start": 10.99,
    "end": 13.43,
    "text": "免疫球蛋白和规范评估",
    "chars_per_second": 4.1
   },
   {
    "i": 6,
    "start": 13.77,
    "end": 15.62,
    "text": "取代了干燥兔脊髓",
    "chars_per_second": 4.32
   },
   {
    "i": 7,
    "start": 15.96,
    "end": 17.69,
    "text": "遇到动物咬伤或抓伤",
    "chars_per_second": 5.2
   },
   {
    "i": 8,
    "start": 18.03,
    "end": 20.75,
    "text": "先用肥皂和流动水彻底清洗",
    "chars_per_second": 4.41
   },
   {
    "i": 9,
    "start": 21.09,
    "end": 24.22,
    "text": "再尽快联系当地医生或公共卫生机构",
    "chars_per_second": 5.11
   },
   {
    "i": 10,
    "start": 24.56,
    "end": 26.3,
    "text": "由专业人员判断下一步",
    "chars_per_second": 5.75
   },
   {
    "i": 11,
    "start": 26.65,
    "end": 27.56,
    "text": "巴斯德留下的",
    "chars_per_second": 6.59
   },
   {
    "i": 12,
    "start": 27.76,
    "end": 28.64,
    "text": "是一个原则",
    "chars_per_second": 5.68
   },
   {
    "i": 13,
    "start": 28.98,
    "end": 30.69,
    "text": "证据要先于传奇",
    "chars_per_second": 4.09
   },
   {
    "i": 14,
    "start": 31.04,
    "end": 33.03,
    "text": "救治要快于病毒",
    "chars_per_second": 3.52
   }
  ]
 }
}