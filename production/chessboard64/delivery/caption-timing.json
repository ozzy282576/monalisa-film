[
  {
    "start": 0.7387371363232118,
    "end": 2.926515055266167,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.236005590141024,
    "end": 5.178325498665989,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.477143946131368,
    "end": 8.700114343793672,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.998932791259051,
    "end": 10.951924787193493,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.261415322068352,
    "end": 14.142878922627364,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.452369457502222,
    "end": 15.957133782238595,
    "text": "并非司法结论。"
  },
  {
    "start": 16.266624317113454,
    "end": 21.474602972938634,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 21.784093507813495,
    "end": 25.124456866980054,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 25.43394740185491,
    "end": 26.703925803582774,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.970727988819718,
    "end": 29.147833820353195,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 30.36657095667641,
    "end": 32.607709312666756,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 32.906527760132136,
    "end": 35.6172379621395,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 35.92672849701436,
    "end": 38.53071782492695,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.84020835980181,
    "end": 42.76753652648965,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 43.077027061364504,
    "end": 44.827249396518866,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 45.13673993139373,
    "end": 47.03637149028078,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 47.33518993774616,
    "end": 48.33836615423707,
    "text": "公开报道说，"
  },
  {
    "start": 48.63718460170246,
    "end": 50.50479989836107,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 50.80361834582645,
    "end": 53.194165925549484,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 53.49298437301486,
    "end": 56.929396518866724,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 57.1855266166942,
    "end": 60.01362978020582,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 60.333792402490154,
    "end": 61.53973827976115,
    "text": "按他的说法，"
  },
  {
    "start": 61.571754541989584,
    "end": 62.99647821115487,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 64.21521534747808,
    "end": 66.48836996569685,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 66.80853258798119,
    "end": 70.41569813238469,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 70.72518866725954,
    "end": 75.09007241773598,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 75.39956295261084,
    "end": 77.27785033667894,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 77.58734087155379,
    "end": 81.60004573751746,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 81.90953627239232,
    "end": 82.65658239105576,
    "text": "出门前，"
  },
  {
    "start": 82.91271248888323,
    "end": 84.52419768771438,
    "text": "她留下一张纸条，"
  },
  {
    "start": 84.99376953373141,
    "end": 87.3096125015881,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 87.34162876381653,
    "end": 89.08117901156142,
    "text": "离开后儿子等着，"
  },
  {
    "start": 89.36932537161732,
    "end": 91.19425231863804,
    "text": "电话始终没有响。"
  },
  {
    "start": 92.40231736755176,
    "end": 95.15571591919704,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 95.45453436666241,
    "end": 96.87392199212296,
    "text": "车站监控显示，"
  },
  {
    "start": 97.18341252699783,
    "end": 98.84825816287636,
    "text": "两人曾经同行。"
  },
  {
    "start": 99.14707661034174,
    "end": 99.87277855418624,
    "text": "纸条、"
  },
  {
    "start": 100.15025282683266,
    "end": 100.87595477067715,
    "text": "票据、"
  },
  {
    "start": 101.17477321814253,
    "end": 101.75106593825433,
    "text": "影像，"
  },
  {
    "start": 102.0605564731292,
    "end": 104.06690890611102,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 104.37639944098588,
    "end": 107.39660017786811,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 107.70609071274296,
    "end": 109.81916401981957,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 110.11798246728495,
    "end": 111.50535383051707,
    "text": "回到比察公园。"
  },
  {
    "start": 111.81484436539192,
    "end": 112.60457883369328,
    "text": "沿着路线，"
  },
  {
    "start": 112.90339728115866,
    "end": 115.49671452166177,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 115.80620505653664,
    "end": 116.78803709820859,
    "text": "每一条证据，"
  },
  {
    "start": 117.08685554567397,
    "end": 119.70685300470078,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 120.925590141024,
    "end": 122.8572379621395,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 123.14538432219538,
    "end": 124.47939524838011,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.78888578325497,
    "end": 125.81340617456485,
    "text": "公开报道说，"
  },
  {
    "start": 126.11222462203023,
    "end": 130.47710837250665,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.78659890738152,
    "end": 132.23800279507049,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.54749332994535,
    "end": 135.0767780459916,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.27954770677167,
    "end": 136.22936348621522,
    "text": "三起未遂。"
  },
  {
    "start": 136.53885402109006,
    "end": 139.08948291195526,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.39897344683013,
    "end": 140.14601956549356,
    "text": "六十三，"
  },
  {
    "start": 140.3274450514547,
    "end": 141.45868631685934,
    "text": "是他的自述，"
  },
  {
    "start": 141.74683267691523,
    "end": 143.0701715156905,
    "text": "不是法院认定。"
  },
  {
    "start": 143.36898996315588,
    "end": 145.1832448227671,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.50340744505144,
    "end": 146.42120696226652,
    "text": "每个数字，"
  },
  {
    "start": 146.66666497268452,
    "end": 148.1180688603735,
    "text": "都要说明来源。"
  },
  {
    "start": 149.32613390928722,
    "end": 150.98030745775628,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.30047008004064,
    "end": 153.09338076483292,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.12539702706133,
    "end": 154.36335916656077,
    "text": "每一格背后，"
  },
  {
    "start": 154.38470334137972,
    "end": 156.3163511624952,
    "text": "都是一个真实的人，"
  },
  {
    "start": 156.72189048405536,
    "end": 159.09109388895945,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.38991233642483,
    "end": 160.48913733960103,
    "text": "留下的沉默，"
  },
  {
    "start": 160.7986278744759,
    "end": 162.61288273408712,
    "text": "同样值得被看见。"
  },
  {
    "start": 162.922373268962,
    "end": 164.3951213314699,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.70461186634478,
    "end": 166.93507813492565,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.23389658239103,
    "end": 169.7098208613899,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 170.00863930885527,
    "end": 170.88375047643245,
    "text": "树影移动，"
  },
  {
    "start": 171.07584804980306,
    "end": 172.60195654935836,
    "text": "行人继续生活。"
  },
  {
    "start": 172.90077499682377,
    "end": 173.99999999999997,
    "text": "记住他们。"
  }
]