[
  {
    "start": 0.7388650453028135,
    "end": 2.9393419170243202,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.2384358607534574,
    "end": 5.161182641869337,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.460276585598474,
    "end": 8.66485455412494,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.974630424415832,
    "end": 10.929422985216975,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.228516928946114,
    "end": 14.112637100619931,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.422412970910825,
    "end": 15.928564616118262,
    "text": "并非司法结论。"
  },
  {
    "start": 16.238340486409157,
    "end": 21.461802575107292,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 21.771578445398188,
    "end": 25.115021459227467,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 25.414115402956604,
    "end": 26.69594659036719,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.962994754411064,
    "end": 29.14210777300906,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 30.360972818311872,
    "end": 32.59349546971864,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 32.91395326657129,
    "end": 35.64852646638054,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 35.95830233667143,
    "end": 38.56469241773962,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.87446828803051,
    "end": 42.805417262756315,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 43.11519313304721,
    "end": 44.867029089175006,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 45.1768049594659,
    "end": 47.07818788745827,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 47.38796375774916,
    "end": 48.39206485455412,
    "text": "公开报道说，"
  },
  {
    "start": 48.691158798283254,
    "end": 50.549814020028606,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 50.8595898903195,
    "end": 53.25234144015259,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 53.56211731044348,
    "end": 57.00169766332856,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 57.258063900810676,
    "end": 60.088774439675724,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 60.40923223652837,
    "end": 61.381287553648065,
    "text": "按他的说法，"
  },
  {
    "start": 61.43469718645684,
    "end": 63.0530090605627,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 64.2718741058655,
    "end": 66.54712446351931,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 66.86758226037195,
    "end": 70.46739151168335,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 70.77716738197424,
    "end": 75.14607534573199,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 75.45585121602288,
    "end": 77.33587029089173,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 77.64564616118264,
    "end": 81.66205054840248,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 81.97182641869335,
    "end": 82.7195612780162,
    "text": "出门前，"
  },
  {
    "start": 82.97592751549831,
    "end": 84.5675345731998,
    "text": "她留下一张纸条，"
  },
  {
    "start": 85.02685741535525,
    "end": 87.35551740581782,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 87.39824511206484,
    "end": 89.12871721506913,
    "text": "离开后儿子等着，"
  },
  {
    "start": 89.41712923223652,
    "end": 91.23305674773485,
    "text": "电话始终没有响。"
  },
  {
    "start": 92.44123986647591,
    "end": 95.19717691940866,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 95.49627086313781,
    "end": 96.9169670958512,
    "text": "车站监控显示，"
  },
  {
    "start": 97.2267429661421,
    "end": 98.89312350977586,
    "text": "两人曾经同行。"
  },
  {
    "start": 99.20289938006675,
    "end": 99.91858845970432,
    "text": "纸条、"
  },
  {
    "start": 100.19631855030995,
    "end": 100.92268955650928,
    "text": "票据、"
  },
  {
    "start": 101.22178350023842,
    "end": 101.7986075345732,
    "text": "影像，"
  },
  {
    "start": 102.10838340486409,
    "end": 104.11658559847399,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 104.4263614687649,
    "end": 107.44934668574152,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 107.75912255603242,
    "end": 109.87414401525987,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 110.17323795898902,
    "end": 111.56188841201715,
    "text": "回到比察公园。"
  },
  {
    "start": 111.87166428230805,
    "end": 112.67280877443966,
    "text": "沿着路线，"
  },
  {
    "start": 112.97190271816879,
    "end": 115.56761087267523,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 115.87738674296612,
    "end": 116.86012398664758,
    "text": "每一条证据，"
  },
  {
    "start": 117.14853600381497,
    "end": 119.78163090128754,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 121.00049594659035,
    "end": 122.93392465426798,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 123.22233667143537,
    "end": 124.55757749165473,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.86735336194562,
    "end": 125.8928183118741,
    "text": "公开报道说，"
  },
  {
    "start": 126.19191225560323,
    "end": 130.55013829279923,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.84923223652837,
    "end": 132.31265617548877,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.6117501192179,
    "end": 135.14336671435382,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.34632331902716,
    "end": 136.29701478302334,
    "text": "三起未遂。"
  },
  {
    "start": 136.60679065331425,
    "end": 139.15977110157365,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.46954697186456,
    "end": 140.2172818311874,
    "text": "六十三，"
  },
  {
    "start": 140.39887458273722,
    "end": 141.53115879828323,
    "text": "是他的自述，"
  },
  {
    "start": 141.81957081545062,
    "end": 143.14412970910823,
    "text": "不是法院认定。"
  },
  {
    "start": 143.44322365283736,
    "end": 145.2591511683357,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.55824511206484,
    "end": 146.47689079637576,
    "text": "每个数字，"
  },
  {
    "start": 146.7225751072961,
    "end": 148.1753171196948,
    "text": "都要说明来源。"
  },
  {
    "start": 149.38350023843583,
    "end": 151.00715307582257,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.31692894611348,
    "end": 153.1114926084883,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.1542203147353,
    "end": 154.38264186933714,
    "text": "每一格背后，"
  },
  {
    "start": 154.40400572246062,
    "end": 156.33743443013827,
    "text": "都是一个真实的人，"
  },
  {
    "start": 156.7540295660467,
    "end": 159.09337148307102,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.39246542680016,
    "end": 160.49270386266093,
    "text": "留下的沉默，"
  },
  {
    "start": 160.79179780639006,
    "end": 162.60772532188838,
    "text": "同样值得被看见。"
  },
  {
    "start": 162.90681926561751,
    "end": 164.3809251311397,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.6907010014306,
    "end": 166.93390557939912,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.23299952312826,
    "end": 169.70052455889362,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 170.01030042918453,
    "end": 170.88621840724844,
    "text": "树影移动，"
  },
  {
    "start": 171.06781115879826,
    "end": 172.58464473056745,
    "text": "行人继续生活。"
  },
  {
    "start": 172.9051025274201,
    "end": 173.99999999999997,
    "text": "记住他们。"
  }
]