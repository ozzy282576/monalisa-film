[
  {
    "start": 0.7264913703231785,
    "end": 2.8184640333603617,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.061716668597243,
    "end": 5.046658172130198,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.328831229004981,
    "end": 8.61760685740762,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.899779914282405,
    "end": 10.836070890767983,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.089053631414341,
    "end": 13.871863778524267,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.144306729989575,
    "end": 15.545441908954013,
    "text": "并非司法结论。"
  },
  {
    "start": 15.817884860419321,
    "end": 20.71212788138538,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 20.994300938260167,
    "end": 24.069014247654348,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 24.351187304529134,
    "end": 25.73286227267462,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.015035329549406,
    "end": 28.155658519633963,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 29.362149889957145,
    "end": 31.551423607089077,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 31.833596663963863,
    "end": 34.67478744353064,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 34.94723039499595,
    "end": 37.846801807019574,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.10951465307541,
    "end": 41.89452565736129,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 42.176698714236075,
    "end": 43.9378477933511,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 44.22002085022588,
    "end": 46.10766129966408,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 46.38983435653886,
    "end": 47.401765319124294,
    "text": "公开报道说，"
  },
  {
    "start": 47.68393837599908,
    "end": 49.4450874551141,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 49.73699061739836,
    "end": 52.276548129271404,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 52.55872118614619,
    "end": 55.91560755241515,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 56.022638711919384,
    "end": 58.87355959689563,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 59.155732653770414,
    "end": 60.342805513726404,
    "text": "按他的说法，"
  },
  {
    "start": 60.36226572454535,
    "end": 61.593124058843976,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 62.799615429167154,
    "end": 65.12511062203174,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 65.40728367890652,
    "end": 69.32851615892505,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 69.60095911039036,
    "end": 73.78490443646473,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 74.06707749333951,
    "end": 75.9255276265493,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 76.1979705780146,
    "end": 80.09974284721417,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 80.38191590408897,
    "end": 81.14086412602803,
    "text": "出门前，"
  },
  {
    "start": 81.42303718290282,
    "end": 83.02850457546623,
    "text": "她留下一张纸条，"
  },
  {
    "start": 83.45662921348315,
    "end": 86.06429746322252,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 86.33674041468782,
    "end": 87.82544654233754,
    "text": "离开后儿子等着，"
  },
  {
    "start": 88.10761959921233,
    "end": 90.03418047028843,
    "text": "电话始终没有响。"
  },
  {
    "start": 91.23094173520214,
    "end": 94.03321209313101,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 94.30565504459632,
    "end": 96.04734391289239,
    "text": "车站监控显示，"
  },
  {
    "start": 96.31005675894822,
    "end": 97.92525425692112,
    "text": "两人曾经同行。"
  },
  {
    "start": 98.19769720838643,
    "end": 98.75231321672652,
    "text": "纸条、"
  },
  {
    "start": 99.0344862736013,
    "end": 99.67667323062666,
    "text": "票据、"
  },
  {
    "start": 99.95884628750144,
    "end": 100.44535155797521,
    "text": "影像，"
  },
  {
    "start": 100.71779450944052,
    "end": 102.62489516969768,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 102.89733812116299,
    "end": 105.88448048187189,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 106.16665353874667,
    "end": 108.30727672883123,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 108.57971968029653,
    "end": 109.91274412139465,
    "text": "回到比察公园。"
  },
  {
    "start": 110.19491717826943,
    "end": 111.1095470867601,
    "text": "沿着路线，"
  },
  {
    "start": 111.38199003822542,
    "end": 114.04803892042165,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 114.33021197729643,
    "end": 115.48809452102398,
    "text": "每一条证据，"
  },
  {
    "start": 115.76053747248929,
    "end": 118.6698389899224,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 119.87633036024557,
    "end": 122.23101586933859,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 122.51318892621337,
    "end": 124.07973589713889,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.36190895401367,
    "end": 125.32518938955172,
    "text": "公开报道说，"
  },
  {
    "start": 125.6073624464265,
    "end": 129.91779914282404,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.19024209428937,
    "end": 131.8248998030812,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.0973427545465,
    "end": 134.7828518475617,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.0163743773891,
    "end": 136.08668597243138,
    "text": "三起未遂。"
  },
  {
    "start": 136.36885902930615,
    "end": 138.78192517085603,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.05436812232134,
    "end": 139.76466581721303,
    "text": "六十三，"
  },
  {
    "start": 140.0468388740878,
    "end": 141.18526120699642,
    "text": "是他的自述，"
  },
  {
    "start": 141.43824394764277,
    "end": 142.81018881037878,
    "text": "不是法院认定。"
  },
  {
    "start": 143.08263176184408,
    "end": 144.91189157882545,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.19406463570022,
    "end": 146.24491601992355,
    "text": "每个数字，"
  },
  {
    "start": 146.48816865516045,
    "end": 147.97687478281014,
    "text": "都要说明来源。"
  },
  {
    "start": 149.18336615313333,
    "end": 151.15857755125683,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.46021081895054,
    "end": 153.61056411444457,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.88300706590988,
    "end": 154.9435885555427,
    "text": "每一格背后，"
  },
  {
    "start": 155.1771110853701,
    "end": 156.87987953202827,
    "text": "都是一个真实的人，"
  },
  {
    "start": 157.13286227267463,
    "end": 159.53619830881502,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.8183713656898,
    "end": 160.9178732769605,
    "text": "留下的沉默，"
  },
  {
    "start": 161.19031622842581,
    "end": 162.94173520213135,
    "text": "同样值得被看见。"
  },
  {
    "start": 163.2336383644156,
    "end": 164.6153133325611,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.8877562840264,
    "end": 166.9018881037878,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.1743310552531,
    "end": 169.55820688057455,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 169.84037993744934,
    "end": 170.78420016216842,
    "text": "树影移动，"
  },
  {
    "start": 171.06637321904321,
    "end": 172.57453955751188,
    "text": "行人继续生活。"
  },
  {
    "start": 172.85671261438665,
    "end": 174.0,
    "text": "记住他们。"
  }
]