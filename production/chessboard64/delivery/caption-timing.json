[
  {
    "start": 0.7265170166545981,
    "end": 2.8189138305575674,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.062215785662563,
    "end": 5.047559739319334,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.3297900072411295,
    "end": 8.60950036205648,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.891730629978277,
    "end": 10.828414192614048,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.081448225923245,
    "end": 13.864822592324401,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.137320782041998,
    "end": 15.538740043446778,
    "text": "并非司法结论。"
  },
  {
    "start": 15.811238233164374,
    "end": 20.706473569876902,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 20.9789717595945,
    "end": 24.05430847212165,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 24.33653874004345,
    "end": 25.718493845039827,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.000724112961628,
    "end": 28.141781317885595,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 29.348298334540193,
    "end": 31.53801593048516,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 31.820246198406956,
    "end": 34.65228095582911,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 34.93451122375091,
    "end": 37.824938450398264,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.10716871832006,
    "end": 41.8929471397538,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 42.175177407675605,
    "end": 43.93668356263578,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 44.21891383055757,
    "end": 46.106937002172344,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 46.389167270094134,
    "end": 47.40130340333093,
    "text": "公开报道说，"
  },
  {
    "start": 47.68353367125272,
    "end": 49.44503982621289,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 49.72727009413469,
    "end": 52.26734250543085,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 52.53984069514845,
    "end": 55.907139753801594,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 56.0141926140478,
    "end": 58.87542360608255,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 59.15765387400435,
    "end": 60.34496741491673,
    "text": "按他的说法，"
  },
  {
    "start": 60.36443157132513,
    "end": 61.59553946415642,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 62.80205648081101,
    "end": 65.13775524981898,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 65.41998551774077,
    "end": 69.34201303403331,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 69.61451122375091,
    "end": 73.79930485155685,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 74.08153511947864,
    "end": 75.94036205648082,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 76.21286024619842,
    "end": 80.11542360608256,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 80.39765387400435,
    "end": 81.15675597393194,
    "text": "出门前，"
  },
  {
    "start": 81.43898624185374,
    "end": 83.04477914554671,
    "text": "她留下一张纸条，"
  },
  {
    "start": 83.4632585083273,
    "end": 86.07145546705287,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 86.35368573497466,
    "end": 87.84269370021724,
    "text": "离开后儿子等着，"
  },
  {
    "start": 88.12492396813904,
    "end": 90.05187545257061,
    "text": "电话始终没有响。"
  },
  {
    "start": 91.248660391021,
    "end": 94.05149891383057,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 94.32399710354817,
    "end": 96.06603910209994,
    "text": "车站监控显示，"
  },
  {
    "start": 96.32880521361334,
    "end": 97.93459811730631,
    "text": "两人曾经同行。"
  },
  {
    "start": 98.2070963070239,
    "end": 98.7618247646633,
    "text": "纸条、"
  },
  {
    "start": 99.04405503258509,
    "end": 99.68637219406229,
    "text": "票据、"
  },
  {
    "start": 99.96860246198408,
    "end": 100.45520637219407,
    "text": "影像，"
  },
  {
    "start": 100.72770456191166,
    "end": 102.63519188993484,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 102.90769007965244,
    "end": 105.89543808834179,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 106.16793627805939,
    "end": 108.30899348298335,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 108.58149167270095,
    "end": 109.90505430847213,
    "text": "回到比察公园。"
  },
  {
    "start": 110.18728457639394,
    "end": 111.09236784938452,
    "text": "沿着路线，"
  },
  {
    "start": 111.36486603910211,
    "end": 114.03145546705287,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 114.31368573497467,
    "end": 115.47180304127446,
    "text": "每一条证据，"
  },
  {
    "start": 115.75403330919625,
    "end": 118.66392469225201,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 119.8704417089066,
    "end": 122.23533671252716,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 122.50783490224475,
    "end": 123.87032585083273,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 123.88979000724113,
    "end": 125.30094134685011,
    "text": "公开报道说，"
  },
  {
    "start": 125.58317161477191,
    "end": 129.89448225923243,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.16698044895003,
    "end": 131.81170166545982,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.0939319333816,
    "end": 134.77998551774078,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.03301955104996,
    "end": 136.08408399710356,
    "text": "三起未遂。"
  },
  {
    "start": 136.36631426502535,
    "end": 138.7798696596669,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.0523678493845,
    "end": 139.7628095582911,
    "text": "六十三，"
  },
  {
    "start": 140.0353077480087,
    "end": 141.18369297610428,
    "text": "是他的自述，"
  },
  {
    "start": 141.44645908761768,
    "end": 142.81868211440985,
    "text": "不是法院认定。"
  },
  {
    "start": 143.10091238233164,
    "end": 144.9500072411296,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.2225054308472,
    "end": 146.2735698769008,
    "text": "每个数字，"
  },
  {
    "start": 146.5168718320058,
    "end": 148.01561187545258,
    "text": "都要说明来源。"
  },
  {
    "start": 149.22212889210715,
    "end": 151.21720492396813,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.47023895727733,
    "end": 153.61129616220128,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.88379435191888,
    "end": 154.94459087617668,
    "text": "每一格背后，"
  },
  {
    "start": 155.17816075307746,
    "end": 156.88127443881245,
    "text": "都是一个真实的人，"
  },
  {
    "start": 157.13430847212163,
    "end": 159.538131788559,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.8203620564808,
    "end": 160.92008689355538,
    "text": "留下的沉默，"
  },
  {
    "start": 161.2023171614772,
    "end": 162.95409123823316,
    "text": "同样值得被看见。"
  },
  {
    "start": 163.22658942795076,
    "end": 164.61827661115132,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.88104272266472,
    "end": 166.9053149891383,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.1778131788559,
    "end": 169.56217233888486,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 169.83467052860246,
    "end": 170.77868211440983,
    "text": "树影移动，"
  },
  {
    "start": 171.06091238233165,
    "end": 172.57911658218683,
    "text": "行人继续生活。"
  },
  {
    "start": 172.86134685010862,
    "end": 174.0,
    "text": "记住他们。"
  }
]