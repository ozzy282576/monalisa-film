[
  {
    "start": 0.7389401361409759,
    "end": 2.9299192060563652,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.239862586678542,
    "end": 5.174336789872129,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.473592467714231,
    "end": 8.67990330173675,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.989846682358928,
    "end": 10.945696291112665,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.24495196895477,
    "end": 14.119944016794959,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.429887397417138,
    "end": 15.936853489407723,
    "text": "并非司法结论。"
  },
  {
    "start": 16.2467968700299,
    "end": 21.45170812392646,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 21.761651504548638,
    "end": 25.106902474712133,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 25.41684585533431,
    "end": 26.699370188943316,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.955875055665118,
    "end": 29.136166422800432,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 30.35510655894141,
    "end": 32.5888364399771,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 32.90946752337935,
    "end": 35.64551943507857,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 35.95546281570075,
    "end": 38.56326229403906,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.873205674661236,
    "end": 42.80628029772886,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 43.11622367835104,
    "end": 44.86900693428335,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 45.17895031490553,
    "end": 47.08136140975889,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 47.380617087600996,
    "end": 48.38526114892805,
    "text": "公开报道说，"
  },
  {
    "start": 48.68451682677015,
    "end": 50.55486481328329,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 50.854120491125386,
    "end": 53.24816591386221,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 53.54742159170431,
    "end": 56.98886188688848,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 57.245366753610284,
    "end": 60.0669202875501,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 60.39823907373243,
    "end": 61.38150772949933,
    "text": "按他的说法，"
  },
  {
    "start": 61.43494624339971,
    "end": 63.054133214581086,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 64.27307335072206,
    "end": 66.54955404287804,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 66.8701851262803,
    "end": 70.46125326038552,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 70.7711966410077,
    "end": 75.16384248361855,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 75.47378586424074,
    "end": 77.35482155353394,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 77.66476493415612,
    "end": 81.69402888224442,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 81.99328456008652,
    "end": 82.74142375469178,
    "text": "出门前，"
  },
  {
    "start": 82.99792862141358,
    "end": 84.59039633564477,
    "text": "她留下一张纸条，"
  },
  {
    "start": 85.06065525796807,
    "end": 87.57226541128571,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 87.88220879190789,
    "end": 89.70980596730072,
    "text": "离开后儿子等着，"
  },
  {
    "start": 89.73118137286087,
    "end": 91.27021057319169,
    "text": "电话始终没有响。"
  },
  {
    "start": 92.47846300655257,
    "end": 95.23589032381194,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 95.53514600165404,
    "end": 96.95661047140403,
    "text": "车站监控显示，"
  },
  {
    "start": 97.2665538520262,
    "end": 98.92314778293785,
    "text": "两人曾经同行。"
  },
  {
    "start": 99.23309116356002,
    "end": 99.94916724982505,
    "text": "纸条、"
  },
  {
    "start": 100.227047522107,
    "end": 100.95381131115211,
    "text": "票据、"
  },
  {
    "start": 101.2530669889942,
    "end": 101.83020293911827,
    "text": "影像，"
  },
  {
    "start": 102.14014631974044,
    "end": 104.14943444239455,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 104.45937782301672,
    "end": 107.48399770977797,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 107.79394109040015,
    "end": 109.89941853807494,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 110.20936191869711,
    "end": 111.59876328010687,
    "text": "回到比察公园。"
  },
  {
    "start": 111.89801895794898,
    "end": 112.6995966664546,
    "text": "沿着路线，"
  },
  {
    "start": 112.99885234429671,
    "end": 115.59596411985495,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 115.89521979769705,
    "end": 116.87848845346396,
    "text": "每一条证据，"
  },
  {
    "start": 117.17774413130606,
    "end": 119.80157516381448,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 121.02051529995546,
    "end": 122.95498950314905,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 123.24355747821107,
    "end": 124.57952032572047,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.88946370634264,
    "end": 125.91548317322984,
    "text": "公开报道说，"
  },
  {
    "start": 126.21473885107194,
    "end": 130.58600928812265,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.89595266874483,
    "end": 132.34948024683504,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.64873592467714,
    "end": 135.17103378077485,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.38478783637635,
    "end": 136.33599338380304,
    "text": "三起未遂。"
  },
  {
    "start": 136.64593676442522,
    "end": 139.20029772886315,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.51024110948532,
    "end": 140.2583803040906,
    "text": "六十三，"
  },
  {
    "start": 140.44007125135187,
    "end": 141.56228004325973,
    "text": "是他的自述，"
  },
  {
    "start": 141.86153572110186,
    "end": 143.18681086583115,
    "text": "不是法院认定。"
  },
  {
    "start": 143.48606654367325,
    "end": 145.302976016286,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.60223169412814,
    "end": 146.52137413321458,
    "text": "每个数字，"
  },
  {
    "start": 146.7671912971563,
    "end": 148.22071887524652,
    "text": "都要说明来源。"
  },
  {
    "start": 149.4289713086074,
    "end": 151.1069406450792,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.363445511801,
    "end": 153.1589795788536,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.2017303899739,
    "end": 154.43081620968255,
    "text": "每一格背后，"
  },
  {
    "start": 154.4521916152427,
    "end": 156.39735352121636,
    "text": "都是一个真实的人，"
  },
  {
    "start": 156.68592149627838,
    "end": 159.05859151345504,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.35784719129714,
    "end": 160.45868057764488,
    "text": "留下的沉默，"
  },
  {
    "start": 160.76862395826706,
    "end": 162.58553343087982,
    "text": "同样值得被看见。"
  },
  {
    "start": 162.895476811502,
    "end": 164.37037979515236,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.68032317577453,
    "end": 166.91405305681022,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.21330873465232,
    "end": 169.69285577962972,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 169.99211145747182,
    "end": 170.868503085438,
    "text": "树影移动，"
  },
  {
    "start": 171.06088173547934,
    "end": 172.58922323303008,
    "text": "行人继续生活。"
  },
  {
    "start": 172.88847891087218,
    "end": 174.0,
    "text": "记住他们。"
  }
]