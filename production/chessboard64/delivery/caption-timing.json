[
  {
    "start": 0.7387768069896743,
    "end": 2.927180301826847,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.236759332803813,
    "end": 5.168959491660048,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.467863383637808,
    "end": 8.670405083399523,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.97998411437649,
    "end": 10.933534551231135,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.243113582208103,
    "end": 14.114725972994439,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.424305003971407,
    "end": 15.929499602859412,
    "text": "并非司法结论。"
  },
  {
    "start": 16.239078633836378,
    "end": 21.459221604447976,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 21.758125496425738,
    "end": 25.099444003177126,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 25.409023034154096,
    "end": 26.679364575059573,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.956918189038923,
    "end": 29.123971405877683,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 30.342748212867356,
    "end": 32.573852263701355,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 32.89410643367752,
    "end": 35.61626687847498,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 35.925845909451944,
    "end": 38.530579825258144,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.84015885623511,
    "end": 42.76861000794281,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 43.07818903891978,
    "end": 44.828911834789515,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 45.138490865766485,
    "end": 47.0386656076251,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 47.337569499602864,
    "end": 48.341032565528195,
    "text": "公开报道说，"
  },
  {
    "start": 48.639936457505954,
    "end": 50.49741064336775,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 50.80698967434472,
    "end": 53.1982208101668,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 53.49712470214456,
    "end": 56.934519459888804,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 57.190722795869746,
    "end": 60.04098490865766,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 60.31853852263701,
    "end": 61.524829229547265,
    "text": "按他的说法，"
  },
  {
    "start": 61.55685464654488,
    "end": 62.97131056393964,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 64.1900873709293,
    "end": 66.46389197776013,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 66.7841461477363,
    "end": 70.39234312946783,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 70.7019221604448,
    "end": 75.05737887212074,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 75.3669579030977,
    "end": 77.24578236695791,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 77.54468625893567,
    "end": 81.56921366163623,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 81.87879269261319,
    "end": 82.61537728355839,
    "text": "出门前，"
  },
  {
    "start": 82.88225575853852,
    "end": 84.46217633042097,
    "text": "她留下一张纸条，"
  },
  {
    "start": 84.93188244638603,
    "end": 87.45121525019857,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 87.75011914217633,
    "end": 89.58624305003971,
    "text": "离开后儿子等着，"
  },
  {
    "start": 89.60759332803813,
    "end": 91.13947577442414,
    "text": "电话始终没有响。"
  },
  {
    "start": 92.34757744241462,
    "end": 95.1017633042097,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 95.40066719618746,
    "end": 96.82046068308182,
    "text": "车站监控显示，"
  },
  {
    "start": 97.13003971405878,
    "end": 98.79536139793488,
    "text": "两人曾经同行。"
  },
  {
    "start": 99.10494042891185,
    "end": 99.82017474185862,
    "text": "纸条、"
  },
  {
    "start": 100.09772835583797,
    "end": 100.82363780778397,
    "text": "票据、"
  },
  {
    "start": 101.12254169976173,
    "end": 101.69899920571883,
    "text": "影像，"
  },
  {
    "start": 102.0085782366958,
    "end": 104.01550436854647,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 104.32508339952344,
    "end": 107.34614773629866,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 107.65572676727562,
    "end": 109.76940428911836,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 110.06830818109611,
    "end": 111.45607625099287,
    "text": "回到比察公园。"
  },
  {
    "start": 111.76565528196983,
    "end": 112.55561556791105,
    "text": "沿着路线，"
  },
  {
    "start": 112.86519459888802,
    "end": 115.4699285146942,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 115.77950754567118,
    "end": 116.7616203335981,
    "text": "每一条证据，"
  },
  {
    "start": 117.06052422557586,
    "end": 119.68127084988086,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 120.90004765687054,
    "end": 122.83224781572679,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 123.12047656870534,
    "end": 124.45486894360606,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.76444797458302,
    "end": 125.78926131850676,
    "text": "公开报道说，"
  },
  {
    "start": 126.08816521048453,
    "end": 130.44362192216045,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.74252581413822,
    "end": 132.1943447180302,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.49324861000795,
    "end": 135.0232565528197,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.22608419380464,
    "end": 136.17617156473392,
    "text": "三起未遂。"
  },
  {
    "start": 136.4857505957109,
    "end": 139.03710881652106,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.34668784749803,
    "end": 140.09394757744244,
    "text": "六十三，"
  },
  {
    "start": 140.27542494042893,
    "end": 141.39631453534554,
    "text": "是他的自述，"
  },
  {
    "start": 141.69521842732328,
    "end": 143.029610802224,
    "text": "不是法院认定。"
  },
  {
    "start": 143.32851469420177,
    "end": 145.14328832406673,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.4635424940429,
    "end": 146.3816044479746,
    "text": "每个数字，"
  },
  {
    "start": 146.62713264495633,
    "end": 148.0789515488483,
    "text": "都要说明来源。"
  },
  {
    "start": 149.28705321683879,
    "end": 150.96305003971406,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.27262907069104,
    "end": 153.0660524225576,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.09807783955523,
    "end": 154.33639396346308,
    "text": "每一格背后，"
  },
  {
    "start": 154.3577442414615,
    "end": 156.28994440031772,
    "text": "都是一个真实的人，"
  },
  {
    "start": 156.69559968228754,
    "end": 159.07615567911043,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.37505957108817,
    "end": 160.47459888800637,
    "text": "留下的沉默，"
  },
  {
    "start": 160.78417791898335,
    "end": 162.5989515488483,
    "text": "同样值得被看见。"
  },
  {
    "start": 162.90853057982528,
    "end": 164.38169976171565,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.69127879269263,
    "end": 166.92238284352663,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.22128673550438,
    "end": 169.7085941223193,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 170.00749801429708,
    "end": 170.88285941223194,
    "text": "树影移动，"
  },
  {
    "start": 171.07501191421764,
    "end": 172.60155679110406,
    "text": "行人继续生活。"
  },
  {
    "start": 172.90046068308183,
    "end": 174.0,
    "text": "记住他们。"
  }
]