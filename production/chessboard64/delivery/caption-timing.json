[
  {
    "start": 0.7264950334482059,
    "end": 2.8087978917494425,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.061787958645854,
    "end": 5.046786945063855,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.328968173525237,
    "end": 8.608108655990266,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.89028988445165,
    "end": 10.826636934928034,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.079627001824445,
    "end": 13.862517737684977,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.134968578958036,
    "end": 15.536144334076624,
    "text": "并非司法结论。"
  },
  {
    "start": 15.818325562538007,
    "end": 20.712710318264744,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 20.99489154672613,
    "end": 24.069693898236363,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 24.35187512669775,
    "end": 25.72385972025137,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.006040948712748,
    "end": 28.141860936549765,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 29.34835596999797,
    "end": 31.53769308737077,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 31.81014392864383,
    "end": 34.66114737482262,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 34.94332860328401,
    "end": 37.833253598216096,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.11543482667748,
    "end": 41.90055544293533,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 42.18273667139671,
    "end": 43.943936752483275,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 44.21638759375634,
    "end": 46.1040827082911,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 46.386263936752485,
    "end": 47.39822420433813,
    "text": "公开报道说，"
  },
  {
    "start": 47.68040543279951,
    "end": 49.451335901074394,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 49.733517129535784,
    "end": 52.263417798499894,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 52.54559902696128,
    "end": 55.92204338130954,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 56.029077640381104,
    "end": 58.889811473748225,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 59.17199270220961,
    "end": 60.35909993918507,
    "text": "按他的说法，"
  },
  {
    "start": 60.37856071356172,
    "end": 61.60945469288465,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 62.81594972633285,
    "end": 65.14151226434218,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 65.42369349280357,
    "end": 69.34503952969794,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 69.617490370971,
    "end": 73.79182647476179,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 74.06427731603486,
    "end": 75.92278126900464,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 76.19523211027771,
    "end": 80.09711737279545,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 80.37929860125683,
    "end": 81.13826880194607,
    "text": "出门前，"
  },
  {
    "start": 81.42045003040745,
    "end": 83.02596391648083,
    "text": "她留下一张纸条，"
  },
  {
    "start": 83.45410095276706,
    "end": 86.06184471923777,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 86.34402594769915,
    "end": 87.83277518751265,
    "text": "离开后儿子等着，"
  },
  {
    "start": 88.10522602878572,
    "end": 90.0415730792621,
    "text": "电话始终没有响。"
  },
  {
    "start": 91.23833772552199,
    "end": 94.04068923575916,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 94.31314007703223,
    "end": 96.05487938374213,
    "text": "车站监控显示，"
  },
  {
    "start": 96.31759983782688,
    "end": 97.92311372390026,
    "text": "两人曾经同行。"
  },
  {
    "start": 98.19556456517331,
    "end": 98.75019663490775,
    "text": "纸条、"
  },
  {
    "start": 99.03237786336913,
    "end": 99.67458341779849,
    "text": "票据、"
  },
  {
    "start": 99.95676464625987,
    "end": 100.44328400567605,
    "text": "影像，"
  },
  {
    "start": 100.71573484694912,
    "end": 102.6131603486722,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 102.88561118994525,
    "end": 105.88257044394891,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 106.15502128522196,
    "end": 108.29570646665314,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 108.5681573079262,
    "end": 109.90122035272653,
    "text": "回到比察公园。"
  },
  {
    "start": 110.18340158118791,
    "end": 111.088327589702,
    "text": "沿着路线，"
  },
  {
    "start": 111.36077843097506,
    "end": 114.0269045205757,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 114.29935536184877,
    "end": 115.45727143725927,
    "text": "每一条证据，"
  },
  {
    "start": 115.73945266572065,
    "end": 118.63910804784106,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 119.84560308128927,
    "end": 122.20035678086356,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 122.48253800932494,
    "end": 124.04913034664503,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.33131157510641,
    "end": 125.28488951956213,
    "text": "公开报道说，"
  },
  {
    "start": 125.56707074802351,
    "end": 129.88736265963917,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.16954388810055,
    "end": 131.78478816136223,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.06696938982364,
    "end": 134.76228664098923,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.00554632069733,
    "end": 136.0661585242246,
    "text": "三起未遂。"
  },
  {
    "start": 136.34833975268597,
    "end": 138.7614757753902,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.03392661666328,
    "end": 139.7442448814109,
    "text": "六十三，"
  },
  {
    "start": 140.01669572268395,
    "end": 141.17461179809445,
    "text": "是他的自述，"
  },
  {
    "start": 141.42760186499086,
    "end": 142.79958645854447,
    "text": "不是法院认定。"
  },
  {
    "start": 143.08176768700588,
    "end": 144.93054125278735,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.2029920940604,
    "end": 146.25387391039934,
    "text": "每个数字，"
  },
  {
    "start": 146.49713359010744,
    "end": 147.99561321710925,
    "text": "都要说明来源。"
  },
  {
    "start": 149.20210825055747,
    "end": 151.1968376241638,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.4790188526252,
    "end": 153.61970403405635,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.89215487532942,
    "end": 154.95276707885668,
    "text": "每一格背后，"
  },
  {
    "start": 155.18629637137644,
    "end": 156.88911412933305,
    "text": "都是一个真实的人，"
  },
  {
    "start": 157.14210419622947,
    "end": 159.5552402189337,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.82769106020677,
    "end": 160.92722481248734,
    "text": "留下的沉默，"
  },
  {
    "start": 161.19967565376038,
    "end": 162.9511453476586,
    "text": "同样值得被看见。"
  },
  {
    "start": 163.24305696330833,
    "end": 164.62477194405028,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.887492398135,
    "end": 166.9114129333063,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.18386377457935,
    "end": 169.56780863571862,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 169.84998986418,
    "end": 170.7938374214474,
    "text": "树影移动，"
  },
  {
    "start": 171.07601864990878,
    "end": 172.58422866409893,
    "text": "行人继续生活。"
  },
  {
    "start": 172.85667950537197,
    "end": 174.0,
    "text": "记住他们。"
  }
]