[
  {
    "start": 0.7265133522562706,
    "end": 2.818849562648439,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.052412674506169,
    "end": 5.057162717951688,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.329653015119041,
    "end": 8.619000173782075,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.901222267276836,
    "end": 10.837849736430515,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.090876440943058,
    "end": 13.87417019058101,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.156392284075768,
    "end": 15.548039158894744,
    "text": "并非司法结论。"
  },
  {
    "start": 15.820529456062097,
    "end": 20.71562300874703,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 20.99784510224179,
    "end": 24.073092741701902,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 24.355314835196662,
    "end": 25.72749811736083,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.009720210855587,
    "end": 28.14584950472108,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 29.352362856977354,
    "end": 31.542017030643574,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 31.81450732781093,
    "end": 34.66592365174072,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 34.93841394890807,
    "end": 37.838489254474894,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.10124775531484,
    "end": 41.87718473034815,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 42.1594068238429,
    "end": 43.920861959103284,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 44.203084052598044,
    "end": 46.091052540114696,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 46.373274633609455,
    "end": 47.385381451659626,
    "text": "公开报道说，"
  },
  {
    "start": 47.66760354515438,
    "end": 49.40959508775995,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 49.72101257023692,
    "end": 52.261011411689736,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 52.5432335051845,
    "end": 55.91043503446678,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 56.01748479406824,
    "end": 58.868901117998035,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 59.15112321149279,
    "end": 59.99778949197706,
    "text": "按他的说法，"
  },
  {
    "start": 60.017253084631875,
    "end": 61.58407229334415,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 62.790585645600416,
    "end": 65.11648496785031,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 65.39870706134508,
    "end": 69.33035277761687,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 69.60284307478422,
    "end": 73.77778369924116,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 74.0502739964085,
    "end": 75.90904709494293,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 76.1815373921103,
    "end": 80.08398771939987,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 80.36620981289462,
    "end": 81.12528992643226,
    "text": "出门前，"
  },
  {
    "start": 81.40751201992701,
    "end": 83.0132584139489,
    "text": "她留下一张纸条，"
  },
  {
    "start": 83.44145745235475,
    "end": 86.0495788680994,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 86.32206916526675,
    "end": 87.8110340033598,
    "text": "离开后儿子等着，"
  },
  {
    "start": 88.08352430052715,
    "end": 90.02015176968082,
    "text": "电话始终没有响。"
  },
  {
    "start": 91.21693332560969,
    "end": 94.01969066790245,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 94.2921809650698,
    "end": 96.03417250767538,
    "text": "车站监控显示，"
  },
  {
    "start": 96.29693100851532,
    "end": 97.90267740253722,
    "text": "两人曾经同行。"
  },
  {
    "start": 98.17516769970457,
    "end": 98.72988009036668,
    "text": "纸条、"
  },
  {
    "start": 99.01210218386144,
    "end": 99.6544007414702,
    "text": "票据、"
  },
  {
    "start": 99.93662283496495,
    "end": 100.42321265133522,
    "text": "影像，"
  },
  {
    "start": 100.69570294850257,
    "end": 102.60313502867405,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 102.8756253258414,
    "end": 105.87301859468226,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 106.14550889184962,
    "end": 108.28650408387881,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 108.55899438104618,
    "end": 109.8727868852459,
    "text": "回到比察公园。"
  },
  {
    "start": 110.15500897874065,
    "end": 111.06006603718936,
    "text": "沿着路线，"
  },
  {
    "start": 111.34228813068412,
    "end": 114.0088003243932,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 114.28129062156056,
    "end": 115.43937438452181,
    "text": "每一条证据，"
  },
  {
    "start": 115.72159647801656,
    "end": 118.6314035799108,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 119.83791693216705,
    "end": 122.20274343972658,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 122.47523373689393,
    "end": 124.0420529456062,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.32427503910095,
    "end": 125.28772287551409,
    "text": "公开报道说，"
  },
  {
    "start": 125.56994496900884,
    "end": 129.89086253837687,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.17308463187163,
    "end": 131.80802641487574,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.08051671204308,
    "end": 134.7762242947344,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.00978740659212,
    "end": 136.0705532062793,
    "text": "三起未遂。"
  },
  {
    "start": 136.35277529977407,
    "end": 138.7662607889706,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.03875108613798,
    "end": 139.74917221803855,
    "text": "六十三，"
  },
  {
    "start": 140.02166251520592,
    "end": 141.17974627816716,
    "text": "是他的自述，"
  },
  {
    "start": 141.4327729826797,
    "end": 142.80495626484387,
    "text": "不是法院认定。"
  },
  {
    "start": 143.08717835833863,
    "end": 144.92648786421825,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.1989781613856,
    "end": 146.25001216474539,
    "text": "每个数字，"
  },
  {
    "start": 146.49330707293052,
    "end": 147.98227191102356,
    "text": "都要说明来源。"
  },
  {
    "start": 149.18878526327984,
    "end": 151.18380351039795,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.44656201123792,
    "end": 153.5972889995945,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.86977929676186,
    "end": 154.93054509644904,
    "text": "每一格背后，"
  },
  {
    "start": 155.16410820830677,
    "end": 156.86717256560274,
    "text": "都是一个真实的人，"
  },
  {
    "start": 157.12019927011528,
    "end": 159.53368475931183,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.81590685280656,
    "end": 160.9155998378034,
    "text": "留下的沉默，"
  },
  {
    "start": 161.18809013497074,
    "end": 162.9398134739037,
    "text": "同样值得被看见。"
  },
  {
    "start": 163.23176736372588,
    "end": 164.62341423854485,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.88617273938482,
    "end": 166.91038637548513,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.1828766726525,
    "end": 169.5671667728668,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 169.84938886636158,
    "end": 170.7933731101199,
    "text": "树影移动，"
  },
  {
    "start": 171.07559520361465,
    "end": 172.5840236343625,
    "text": "行人继续生活。"
  },
  {
    "start": 172.85651393152986,
    "end": 174.0,
    "text": "记住他们。"
  }
]