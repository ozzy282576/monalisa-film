[
  {
    "start": 0.7388076776407779,
    "end": 2.9276979788991992,
    "text": "他常在公园和人下棋，"
  },
  {
    "start": 3.237345875174781,
    "end": 5.169975848480997,
    "text": "看起来像个普通棋友。"
  },
  {
    "start": 5.468946231091903,
    "end": 8.67220033049447,
    "text": "可他盯上的是一块六十四格的棋盘。"
  },
  {
    "start": 8.981848226770053,
    "end": 10.935833227405617,
    "text": "媒体给他起了一个绰号，"
  },
  {
    "start": 11.234803610016526,
    "end": 14.117732299478833,
    "text": "六十四格的说法来自他的自述，"
  },
  {
    "start": 14.427380195754418,
    "end": 15.932909622473623,
    "text": "并非司法结论。"
  },
  {
    "start": 16.242557518749205,
    "end": 21.44250667344604,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂。"
  },
  {
    "start": 21.741477056056947,
    "end": 25.08353883310029,
    "text": "他曾声称目标是填满六十四格。"
  },
  {
    "start": 25.393186729375874,
    "end": 26.663810855472228,
    "text": "我们只谈证据，"
  },
  {
    "start": 26.941426210753786,
    "end": 29.10896148468285,
    "text": "也记住格子背后的人。"
  },
  {
    "start": 30.327769162323627,
    "end": 32.55936951824075,
    "text": "亚历山大·皮丘什金，"
  },
  {
    "start": 32.879694928181,
    "end": 35.60246091267319,
    "text": "三十三岁时在莫斯科受审。"
  },
  {
    "start": 35.91210880894877,
    "end": 38.51742214312952,
    "text": "成年后他在超市做理货员。"
  },
  {
    "start": 38.82707003940511,
    "end": 42.75639506800559,
    "text": "下班后他常去莫斯科南部的比察公园。"
  },
  {
    "start": 43.06604296428117,
    "end": 44.817155205287904,
    "text": "那里有石桌和长椅，"
  },
  {
    "start": 45.12680310156349,
    "end": 47.03807804754035,
    "text": "常有人停下来下棋。"
  },
  {
    "start": 47.337048430151256,
    "end": 48.34073471463073,
    "text": "公开报道说，"
  },
  {
    "start": 48.639705097241645,
    "end": 50.486914961230454,
    "text": "他会邀陌生人喝酒，"
  },
  {
    "start": 50.80724037117071,
    "end": 53.199003432057964,
    "text": "理由是悼念死去的小狗。"
  },
  {
    "start": 53.49797381466887,
    "end": 56.936133214694294,
    "text": "人们只当他是熟悉的棋友。"
  },
  {
    "start": 57.19239354264649,
    "end": 60.011257150120755,
    "text": "他声称留下六十三个记号，"
  },
  {
    "start": 60.34226007372568,
    "end": 61.548819117833986,
    "text": "按他的说法，"
  },
  {
    "start": 61.58085165882801,
    "end": 63.00629973306216,
    "text": "棋盘几乎被填满。"
  },
  {
    "start": 64.22510741070295,
    "end": 66.49941782127877,
    "text": "二〇〇二年公开报道记载，"
  },
  {
    "start": 66.81974323121902,
    "end": 70.42874284987924,
    "text": "一位女性幸存者曾向警方报告遭遇。"
  },
  {
    "start": 70.72771323249015,
    "end": 75.11617134867167,
    "text": "报道指出这条线索当时没有得到及时跟进。"
  },
  {
    "start": 75.42581924494725,
    "end": 77.3050616499301,
    "text": "我们不补写她的经历。"
  },
  {
    "start": 77.61470954620567,
    "end": 81.62945468412356,
    "text": "多年后超市同事玛丽娜与他约好散步。"
  },
  {
    "start": 81.93910258039914,
    "end": 82.6865285369264,
    "text": "出门前，"
  },
  {
    "start": 82.94278886487861,
    "end": 84.53373840091521,
    "text": "她留下一张纸条，"
  },
  {
    "start": 84.99287148849626,
    "end": 87.32056946739544,
    "text": "写下同行者的姓名和电话。"
  },
  {
    "start": 87.35260200838948,
    "end": 89.09303673573154,
    "text": "离开后儿子等着，"
  },
  {
    "start": 89.38132960467777,
    "end": 91.20718444133723,
    "text": "电话始终没有响。"
  },
  {
    "start": 92.41531460531334,
    "end": 95.17011313079954,
    "text": "警方发现她衣袋里的地铁票。"
  },
  {
    "start": 95.46908351341045,
    "end": 96.88919283081225,
    "text": "车站监控显示，"
  },
  {
    "start": 97.19884072708784,
    "end": 98.86453285877717,
    "text": "两人曾经同行。"
  },
  {
    "start": 99.17418075505275,
    "end": 99.88957417058599,
    "text": "纸条、"
  },
  {
    "start": 100.16718952586754,
    "end": 100.89326045506546,
    "text": "票据、"
  },
  {
    "start": 101.19223083767636,
    "end": 101.76881657556883,
    "text": "影像，"
  },
  {
    "start": 102.07846447184441,
    "end": 104.08583704080336,
    "text": "三条线索彼此核对。"
  },
  {
    "start": 104.39548493707893,
    "end": 107.41722130418202,
    "text": "这里的画面不是警方原始证物。"
  },
  {
    "start": 107.72686920045761,
    "end": 109.8410169060633,
    "text": "调查从一张小票开始，"
  },
  {
    "start": 110.1399872886742,
    "end": 111.52806406508199,
    "text": "回到比察公园。"
  },
  {
    "start": 111.83771196135757,
    "end": 112.62784797254353,
    "text": "沿着路线，"
  },
  {
    "start": 112.92681835515444,
    "end": 115.5321316893352,
    "text": "警方逐步锁定熟悉的同事。"
  },
  {
    "start": 115.84177958561078,
    "end": 116.8241108427609,
    "text": "每一条证据，"
  },
  {
    "start": 117.1230812253718,
    "end": 119.74441083004957,
    "text": "都需要与下一条相互印证。"
  },
  {
    "start": 120.96321850769036,
    "end": 122.89584848099656,
    "text": "二〇〇六年六月十六日，"
  },
  {
    "start": 123.18414134994279,
    "end": 124.5188305580272,
    "text": "皮丘什金被捕。"
  },
  {
    "start": 124.82847845430278,
    "end": 125.8535197661116,
    "text": "公开报道说，"
  },
  {
    "start": 126.1524901487225,
    "end": 130.50891572391,
    "text": "警方在他住处找到与棋盘记号相关的证物。"
  },
  {
    "start": 130.81856362018559,
    "end": 132.27070547858142,
    "text": "二〇〇七年十月，"
  },
  {
    "start": 132.5696758611923,
    "end": 135.10024659972035,
    "text": "陪审团认定四十八起谋杀、"
  },
  {
    "start": 135.30311935934918,
    "end": 136.25341807550527,
    "text": "三起未遂。"
  },
  {
    "start": 136.56306597178084,
    "end": 139.11499173763823,
    "text": "法院随后判处终身监禁。"
  },
  {
    "start": 139.4246396339138,
    "end": 140.1720655904411,
    "text": "六十三，"
  },
  {
    "start": 140.35358332274055,
    "end": 141.47472225753145,
    "text": "是他的自述，"
  },
  {
    "start": 141.77369264014237,
    "end": 143.09770433456208,
    "text": "不是法院认定。"
  },
  {
    "start": 143.396674717173,
    "end": 145.22252955383246,
    "text": "法庭结论来自证据。"
  },
  {
    "start": 145.52149993644338,
    "end": 146.43976611160542,
    "text": "每个数字，"
  },
  {
    "start": 146.68534892589298,
    "end": 148.1374907842888,
    "text": "都要说明来源。"
  },
  {
    "start": 149.3456209482649,
    "end": 151.0219905936189,
    "text": "法律结论写在案卷里，"
  },
  {
    "start": 151.31028346256514,
    "end": 153.1041057582306,
    "text": "受害者却不是数字。"
  },
  {
    "start": 153.1468158128893,
    "end": 154.37472988432694,
    "text": "每一格背后，"
  },
  {
    "start": 154.3960849116563,
    "end": 156.3287148849625,
    "text": "都是一个真实的人，"
  },
  {
    "start": 156.73446040422016,
    "end": 159.08351341044872,
    "text": "也是一个失去亲人的家庭。"
  },
  {
    "start": 159.3824837930596,
    "end": 160.48226770052116,
    "text": "留下的沉默，"
  },
  {
    "start": 160.79191559679674,
    "end": 162.60709291979154,
    "text": "同样值得被看见。"
  },
  {
    "start": 162.91674081606712,
    "end": 164.3902377017923,
    "text": "我们不重现伤害，"
  },
  {
    "start": 164.69988559806788,
    "end": 166.931485953985,
    "text": "也不把凶手变成传奇。"
  },
  {
    "start": 167.23045633659592,
    "end": 169.70763950680055,
    "text": "让棋盘回到公园石桌上。"
  },
  {
    "start": 170.00660988941146,
    "end": 170.88216600991484,
    "text": "树影移动，"
  },
  {
    "start": 171.07436125587898,
    "end": 172.60124570992753,
    "text": "行人继续生活。"
  },
  {
    "start": 172.90021609253844,
    "end": 174.0,
    "text": "记住他们。"
  }
]