{
 "N01": {
  "duration": 27.358,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 2.19,
    "text": "他常在公园和人下棋",
    "chars_per_second": 4.31
   },
   {
    "i": 1,
    "start": 2.53,
    "end": 4.48,
    "text": "看起来像个普通棋友",
    "chars_per_second": 4.62
   },
   {
    "i": 2,
    "start": 4.83,
    "end": 8.08,
    "text": "可他盯上的是一块六十四格的棋盘",
    "chars_per_second": 4.62
   },
   {
    "i": 3,
    "start": 8.42,
    "end": 10.32,
    "text": "媒体给他起了一个绰号",
    "chars_per_second": 5.26
   },
   {
    "i": 4,
    "start": 10.67,
    "end": 13.38,
    "text": "六十四格的说法来自他的自述",
    "chars_per_second": 4.8
   },
   {
    "i": 5,
    "start": 13.73,
    "end": 15.16,
    "text": "并非司法结论",
    "chars_per_second": 4.2
   },
   {
    "i": 6,
    "start": 15.5,
    "end": 20.54,
    "text": "二〇〇七年法院认定四十八起谋杀和三起未遂",
    "chars_per_second": 3.97
   },
   {
    "i": 7,
    "start": 20.78,
    "end": 23.69,
    "text": "他曾声称目标是填满六十四格",
    "chars_per_second": 4.47
   },
   {
    "i": 8,
    "start": 24.04,
    "end": 25.2,
    "text": "我们只谈证据",
    "chars_per_second": 5.17
   },
   {
    "i": 9,
    "start": 25.54,
    "end": 27.36,
    "text": "也记住格子背后的人",
    "chars_per_second": 4.95
   }
  ]
 },
 "N02": {
  "duration": 31.983,
  "clauses": [
   {
    "i": 0,
    "start": 0.11,
    "end": 1.99,
    "text": "亚历山大·皮丘什金",
    "chars_per_second": 4.26
   },
   {
    "i": 1,
    "start": 2.32,
    "end": 4.92,
    "text": "三十三岁时在莫斯科受审",
    "chars_per_second": 4.23
   },
   {
    "i": 2,
    "start": 5.27,
    "end": 7.91,
    "text": "成年后他在超市做理货员",
    "chars_per_second": 4.17
   },
   {
    "i": 3,
    "start": 8.26,
    "end": 12.05,
    "text": "下班后他常去莫斯科南部的比察公园",
    "chars_per_second": 4.22
   },
   {
    "i": 4,
    "start": 12.4,
    "end": 14.39,
    "text": "那里有石桌和长椅",
    "chars_per_second": 4.02
   },
   {
    "i": 5,
    "start": 14.74,
    "end": 16.64,
    "text": "常有人停下来下棋",
    "chars_per_second": 4.21
   },
   {
    "i": 6,
    "start": 16.99,
    "end": 18.21,
    "text": "公开报道说",
    "chars_per_second": 4.1
   },
   {
    "i": 7,
    "start": 18.54,
    "end": 20.27,
    "text": "他会邀陌生人喝酒",
    "chars_per_second": 4.62
   },
   {
    "i": 8,
    "start": 20.61,
    "end": 22.88,
    "text": "理由是悼念死去的小狗",
    "chars_per_second": 4.41
   },
   {
    "i": 9,
    "start": 23.22,
    "end": 25.42,
    "text": "人们只当他是熟悉的棋友",
    "chars_per_second": 5.0
   },
   {
    "i": 10,
    "start": 25.77,
    "end": 28.12,
    "text": "他声称留下六十三个记号",
    "chars_per_second": 4.68
   },
   {
    "i": 11,
    "start": 28.46,
    "end": 29.47,
    "text": "按他的说法",
    "chars_per_second": 4.95
   },
   {
    "i": 12,
    "start": 29.82,
    "end": 31.98,
    "text": "棋盘几乎被填满",
    "chars_per_second": 3.24
   }
  ]
 },
 "N03": {
  "duration": 26.875,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.49,
    "text": "二〇〇二年公开报道记载",
    "chars_per_second": 4.68
   },
   {
    "i": 1,
    "start": 2.83,
    "end": 6.12,
    "text": "一位女性幸存者曾向警方报告遭遇",
    "chars_per_second": 4.56
   },
   {
    "i": 2,
    "start": 6.47,
    "end": 10.44,
    "text": "报道指出这条线索当时没有得到及时跟进",
    "chars_per_second": 4.53
   },
   {
    "i": 3,
    "start": 10.79,
    "end": 12.5,
    "text": "我们不补写她的经历",
    "chars_per_second": 5.26
   },
   {
    "i": 4,
    "start": 12.85,
    "end": 16.59,
    "text": "多年后超市同事玛丽娜与他约好散步",
    "chars_per_second": 4.28
   },
   {
    "i": 5,
    "start": 16.87,
    "end": 17.78,
    "text": "出门前",
    "chars_per_second": 3.3
   },
   {
    "i": 6,
    "start": 18.06,
    "end": 19.59,
    "text": "她留下一张纸条",
    "chars_per_second": 4.58
   },
   {
    "i": 7,
    "start": 20.08,
    "end": 22.63,
    "text": "写下同行者的姓名和电话",
    "chars_per_second": 4.31
   },
   {
    "i": 8,
    "start": 22.98,
    "end": 24.86,
    "text": "离开后儿子等着",
    "chars_per_second": 3.72
   },
   {
    "i": 9,
    "start": 25.21,
    "end": 26.88,
    "text": "电话始终没有响",
    "chars_per_second": 4.2
   }
  ]
 },
 "N04": {
  "duration": 26.345,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.76,
    "text": "警方发现她衣袋里的地铁票",
    "chars_per_second": 4.6
   },
   {
    "i": 1,
    "start": 3.11,
    "end": 4.63,
    "text": "车站监控显示",
    "chars_per_second": 3.95
   },
   {
    "i": 2,
    "start": 4.95,
    "end": 6.4,
    "text": "两人曾经同行",
    "chars_per_second": 4.14
   },
   {
    "i": 3,
    "start": 6.74,
    "end": 7.39,
    "text": "纸条",
    "chars_per_second": 3.08
   },
   {
    "i": 4,
    "start": 7.59,
    "end": 8.2,
    "text": "票据",
    "chars_per_second": 3.28
   },
   {
    "i": 5,
    "start": 8.44,
    "end": 8.97,
    "text": "影像",
    "chars_per_second": 3.77
   },
   {
    "i": 6,
    "start": 9.24,
    "end": 11.05,
    "text": "三条线索彼此核对",
    "chars_per_second": 4.42
   },
   {
    "i": 7,
    "start": 11.39,
    "end": 14.08,
    "text": "这里的画面不是警方原始证物",
    "chars_per_second": 4.83
   },
   {
    "i": 8,
    "start": 14.42,
    "end": 16.7,
    "text": "调查从一张小票开始",
    "chars_per_second": 3.95
   },
   {
    "i": 9,
    "start": 17.05,
    "end": 18.26,
    "text": "回到比察公园",
    "chars_per_second": 4.96
   },
   {
    "i": 10,
    "start": 18.48,
    "end": 19.39,
    "text": "沿着路线",
    "chars_per_second": 4.4
   },
   {
    "i": 11,
    "start": 19.68,
    "end": 22.04,
    "text": "警方逐步锁定熟悉的同事",
    "chars_per_second": 4.66
   },
   {
    "i": 12,
    "start": 22.39,
    "end": 23.46,
    "text": "每一条证据",
    "chars_per_second": 4.67
   },
   {
    "i": 13,
    "start": 23.8,
    "end": 26.34,
    "text": "都需要与下一条相互印证",
    "chars_per_second": 4.32
   }
  ]
 },
 "N05": {
  "duration": 27.13,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 2.15,
    "text": "二〇〇六年六月十六日",
    "chars_per_second": 4.85
   },
   {
    "i": 1,
    "start": 2.41,
    "end": 3.69,
    "text": "皮丘什金被捕",
    "chars_per_second": 4.69
   },
   {
    "i": 2,
    "start": 4.0,
    "end": 5.12,
    "text": "公开报道说",
    "chars_per_second": 4.46
   },
   {
    "i": 3,
    "start": 5.46,
    "end": 9.14,
    "text": "警方在他住处找到与棋盘记号相关的证物",
    "chars_per_second": 4.89
   },
   {
    "i": 4,
    "start": 9.48,
    "end": 10.97,
    "text": "二〇〇七年十月",
    "chars_per_second": 4.7
   },
   {
    "i": 5,
    "start": 11.31,
    "end": 13.62,
    "text": "陪审团认定四十八起谋杀",
    "chars_per_second": 4.76
   },
   {
    "i": 6,
    "start": 13.97,
    "end": 14.93,
    "text": "三起未遂",
    "chars_per_second": 4.17
   },
   {
    "i": 7,
    "start": 15.2,
    "end": 17.58,
    "text": "法院随后判处终身监禁",
    "chars_per_second": 4.2
   },
   {
    "i": 8,
    "start": 17.83,
    "end": 18.66,
    "text": "六十三",
    "chars_per_second": 3.61
   },
   {
    "i": 9,
    "start": 19.0,
    "end": 20.13,
    "text": "是他的自述",
    "chars_per_second": 4.42
   },
   {
    "i": 10,
    "start": 20.47,
    "end": 21.74,
    "text": "不是法院认定",
    "chars_per_second": 4.72
   },
   {
    "i": 11,
    "start": 22.09,
    "end": 23.96,
    "text": "法庭结论来自证据",
    "chars_per_second": 4.28
   },
   {
    "i": 12,
    "start": 24.3,
    "end": 25.29,
    "text": "每个数字",
    "chars_per_second": 4.04
   },
   {
    "i": 13,
    "start": 25.64,
    "end": 27.13,
    "text": "都要说明来源",
    "chars_per_second": 4.03
   }
  ]
 },
 "N06": {
  "duration": 24.3,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.13,
    "text": "法律结论写在案卷里",
    "chars_per_second": 4.52
   },
   {
    "i": 1,
    "start": 2.48,
    "end": 4.37,
    "text": "受害者却不是数字",
    "chars_per_second": 4.23
   },
   {
    "i": 2,
    "start": 4.72,
    "end": 5.73,
    "text": "每一格背后",
    "chars_per_second": 4.95
   },
   {
    "i": 3,
    "start": 6.01,
    "end": 7.55,
    "text": "都是一个真实的人",
    "chars_per_second": 5.19
   },
   {
    "i": 4,
    "start": 7.9,
    "end": 10.26,
    "text": "也是一个失去亲人的家庭",
    "chars_per_second": 4.66
   },
   {
    "i": 5,
    "start": 10.6,
    "end": 11.66,
    "text": "留下的沉默",
    "chars_per_second": 4.72
   },
   {
    "i": 6,
    "start": 12.01,
    "end": 13.47,
    "text": "同样值得被看见",
    "chars_per_second": 4.79
   },
   {
    "i": 7,
    "start": 13.78,
    "end": 15.25,
    "text": "我们不重现伤害",
    "chars_per_second": 4.76
   },
   {
    "i": 8,
    "start": 15.52,
    "end": 17.54,
    "text": "也不把凶手变成传奇",
    "chars_per_second": 4.46
   },
   {
    "i": 9,
    "start": 17.85,
    "end": 20.06,
    "text": "让棋盘回到公园石桌上",
    "chars_per_second": 4.52
   },
   {
    "i": 10,
    "start": 20.31,
    "end": 21.24,
    "text": "树影移动",
    "chars_per_second": 4.3
   },
   {
    "i": 11,
    "start": 21.59,
    "end": 22.99,
    "text": "行人继续生活",
    "chars_per_second": 4.29
   },
   {
    "i": 12,
    "start": 23.35,
    "end": 24.3,
    "text": "记住他们",
    "chars_per_second": 4.21
   }
  ]
 }
}