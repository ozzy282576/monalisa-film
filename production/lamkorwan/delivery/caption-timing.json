[
  {
    "start": 0.657818056670873,
    "end": 2.161087530113571,
    "text": "一九八二年二月，"
  },
  {
    "start": 2.247814615119881,
    "end": 3.6065389468853963,
    "text": "香港的雨夜。"
  },
  {
    "start": 3.702902374670185,
    "end": 5.630170930365952,
    "text": "有人从沙田城门河里，"
  },
  {
    "start": 5.736170700929218,
    "end": 9.870161752896639,
    "text": "捞起一颗人头和一双女人的手臂——这起案子，"
  },
  {
    "start": 9.966525180681428,
    "end": 11.527612710794997,
    "text": "让整个香港慌了。"
  },
  {
    "start": 11.633612481358265,
    "end": 13.483790294826202,
    "text": "但真正钉死凶手的，"
  },
  {
    "start": 13.58015372261099,
    "end": 14.765423884363887,
    "text": "不是目击者，"
  },
  {
    "start": 14.871423654927154,
    "end": 15.81578524721808,
    "text": "不是指纹，"
  },
  {
    "start": 15.912148675002868,
    "end": 19.169232534128714,
    "text": "而是一卷送去冲印店的菲林。"
  },
  {
    "start": 19.265595961913505,
    "end": 21.636136285419294,
    "text": "今天讲雨夜屠夫林过云："
  },
  {
    "start": 21.732499713204085,
    "end": 24.80649305953883,
    "text": "一个夜班出租车司机，"
  },
  {
    "start": 24.912492830102103,
    "end": 26.24712630492142,
    "text": "和四条人命。"
  },
  {
    "start": 27.32712630492142,
    "end": 28.030579327750377,
    "text": "林过云，"
  },
  {
    "start": 28.261851554433868,
    "end": 29.032758976712174,
    "text": "二十七岁，"
  },
  {
    "start": 29.32184926006654,
    "end": 30.767300676838364,
    "text": "夜班的士司机，"
  },
  {
    "start": 30.921482161294026,
    "end": 33.002932201445454,
    "text": "住在土瓜湾一栋旧唐楼里。"
  },
  {
    "start": 33.04147757255937,
    "end": 34.71820121601469,
    "text": "白天他几乎不出现，"
  },
  {
    "start": 34.94947344269818,
    "end": 36.414197545026965,
    "text": "入夜才开车上街。"
  },
  {
    "start": 36.64546977171045,
    "end": 37.763285534014,
    "text": "凌晨的尖沙咀，"
  },
  {
    "start": 37.93673970402662,
    "end": 40.21091659974762,
    "text": "搭车的大多是下班回家的女人。"
  },
  {
    "start": 40.268734656418495,
    "end": 41.810549500975114,
    "text": "从二月到七月，"
  },
  {
    "start": 42.15745784100035,
    "end": 43.83418148445566,
    "text": "四名女子坐上他的车，"
  },
  {
    "start": 44.08472639669611,
    "end": 45.067633360100956,
    "text": "再没有下车："
  },
  {
    "start": 45.20254215899966,
    "end": 46.87926580245498,
    "text": "二十二岁的陈凤兰，"
  },
  {
    "start": 46.87926580245498,
    "end": 48.69089824480899,
    "text": "三十一岁的陈云洁，"
  },
  {
    "start": 48.960715842606405,
    "end": 50.598894114947804,
    "text": "二十九岁的梁秀云，"
  },
  {
    "start": 50.926529769416085,
    "end": 52.48761729952966,
    "text": "还有十七岁的梁惠心。"
  },
  {
    "start": 53.72661695537456,
    "end": 55.94297579442469,
    "text": "作案几乎都挑在雨夜。"
  },
  {
    "start": 55.94297579442469,
    "end": 57.966607777905246,
    "text": "他把车开到僻静处，"
  },
  {
    "start": 57.966607777905246,
    "end": 60.08660318917059,
    "text": "然后在车里勒死对方。"
  },
  {
    "start": 60.08660318917059,
    "end": 60.87678329700586,
    "text": "四个月里，"
  },
  {
    "start": 60.87678329700586,
    "end": 63.1316875071699,
    "text": "香港连着发生四起命案，"
  },
  {
    "start": 63.1316875071699,
    "end": 67.91131352529541,
    "text": "警方一开始并不确定它们出自同一双手——因为现"
  },
  {
    "start": 67.91131352529541,
    "end": 69.97349087988988,
    "text": "场几乎没有留下什么。"
  },
  {
    "start": 69.97349087988988,
    "end": 73.94366410462315,
    "text": "而林过云做了一件他自以为很聪明的事："
  },
  {
    "start": 73.94366410462315,
    "end": 76.23711368590112,
    "text": "他把整个过程拍了下来，"
  },
  {
    "start": 76.23711368590112,
    "end": 77.7018377882299,
    "text": "照片和录像带，"
  },
  {
    "start": 77.7018377882299,
    "end": 79.48937937363772,
    "text": "整整齐齐收在家里。"
  },
  {
    "start": 80.61756108753012,
    "end": 82.64119307101068,
    "text": "转折点是一间冲印店。"
  },
  {
    "start": 82.74719284157395,
    "end": 84.55882528392797,
    "text": "林过云家里没有暗房，"
  },
  {
    "start": 84.65518871171275,
    "end": 88.31699896753472,
    "text": "习惯把菲林拿到尖沙咀一间相铺冲洗。"
  },
  {
    "start": 88.43263508087647,
    "end": 89.88772284042676,
    "text": "一九八二年八月，"
  },
  {
    "start": 89.98408626821156,
    "end": 91.61262819777447,
    "text": "他想放大一批相片，"
  },
  {
    "start": 91.71862796833774,
    "end": 93.85789606516005,
    "text": "偏巧放大机坏了，"
  },
  {
    "start": 93.9638958357233,
    "end": 95.65989216473558,
    "text": "底片被转到分店，"
  },
  {
    "start": 95.75625559252038,
    "end": 96.83552598371,
    "text": "由人手冲晒。"
  },
  {
    "start": 96.95116209705175,
    "end": 99.62042904669039,
    "text": "店员把照片看清楚的那一刻，"
  },
  {
    "start": 99.72642881725365,
    "end": 103.36896638751865,
    "text": "就知道这不是普通摄影——画面里的东西，"
  },
  {
    "start": 103.47496615808191,
    "end": 106.0767787082712,
    "text": "和报纸上正在报道的那宗案子，"
  },
  {
    "start": 106.18277847883448,
    "end": 107.1271400711254,
    "text": "太像了。"
  },
  {
    "start": 107.23313984168867,
    "end": 108.93395434209017,
    "text": "负责人报了警。"
  },
  {
    "start": 110.06213605598258,
    "end": 111.94122289778595,
    "text": "警方没有立刻上门。"
  },
  {
    "start": 112.04722266834922,
    "end": 114.18649076517153,
    "text": "他们让店员照常打电话，"
  },
  {
    "start": 114.29249053573479,
    "end": 117.64593782264542,
    "text": "通知客人来取相——因为底片还在店里，"
  },
  {
    "start": 117.76157393598717,
    "end": 119.59247906389815,
    "text": "来取的人只能是他。"
  },
  {
    "start": 119.68884249168293,
    "end": 120.53684065618907,
    "text": "八月十八日，"
  },
  {
    "start": 120.63320408397387,
    "end": 122.04974647241025,
    "text": "林过云走进冲印店，"
  },
  {
    "start": 122.13647355741656,
    "end": 123.59156131696686,
    "text": "埋伏的探员一拥而上。"
  },
  {
    "start": 123.69756108753013,
    "end": 124.42992313869452,
    "text": "同一天，"
  },
  {
    "start": 124.53592290925779,
    "end": 127.91827922450386,
    "text": "警方搜查他在土瓜湾贵州街的住所："
  },
  {
    "start": 128.01464265228864,
    "end": 128.69882298956065,
    "text": "照片、"
  },
  {
    "start": 128.73736836067457,
    "end": 129.50827578295286,
    "text": "录像带、"
  },
  {
    "start": 129.61427555351614,
    "end": 130.56827348858553,
    "text": "手术器材，"
  },
  {
    "start": 130.66463691637034,
    "end": 132.24499713204085,
    "text": "一件一件被翻出来。"
  },
  {
    "start": 132.34136055982566,
    "end": 134.20117471607205,
    "text": "四起互不相干的命案，"
  },
  {
    "start": 134.30717448663532,
    "end": 136.29226109900196,
    "text": "从此串成一条线。"
  },
  {
    "start": 137.37226109900197,
    "end": 139.0393483996788,
    "text": "一九八三年三月，"
  },
  {
    "start": 139.38625673970404,
    "end": 141.236434553172,
    "text": "案件在高等法院开审。"
  },
  {
    "start": 141.35207066651373,
    "end": 142.2386142021338,
    "text": "争的是："
  },
  {
    "start": 142.39279568658944,
    "end": 144.12733738671562,
    "text": "他到底有没有精神病。"
  },
  {
    "start": 144.16588275782956,
    "end": 146.72914993690492,
    "text": "五名精神科医生评估过他，"
  },
  {
    "start": 146.8255133646897,
    "end": 149.15750831708158,
    "text": "陪审团最终不接受这个说法。"
  },
  {
    "start": 149.23459905930943,
    "end": 150.27532407938514,
    "text": "四月八日，"
  },
  {
    "start": 150.48732362051166,
    "end": 152.2604106917518,
    "text": "四项谋杀罪名成立，"
  },
  {
    "start": 152.35677411953657,
    "end": 153.7058621085236,
    "text": "判处死刑。"
  },
  {
    "start": 153.80222553630838,
    "end": 157.90730755994036,
    "text": "但香港多年没有执行死刑——一九八四年八月，"
  },
  {
    "start": 158.04221635883908,
    "end": 160.70184696569922,
    "text": "港督会同行政局赦免死刑，"
  },
  {
    "start": 160.79821039348403,
    "end": 162.14729838247106,
    "text": "改判终身监禁。"
  },
  {
    "start": 162.32075255248367,
    "end": 165.09601927268557,
    "text": "他想让全世界看见自己的作品，"
  },
  {
    "start": 165.09601927268557,
    "end": 166.73419754502697,
    "text": "把他送上法庭的，"
  },
  {
    "start": 166.92692440059656,
    "end": 168.17964896179882,
    "text": "正是那卷菲林。"
  },
  {
    "start": 168.39164850292534,
    "end": 169.10473786853277,
    "text": "你觉得，"
  },
  {
    "start": 169.47091889411496,
    "end": 171.53309624870946,
    "text": "如果那台放大机没有坏，"
  },
  {
    "start": 171.6487323620512,
    "end": 173.84581851554435,
    "text": "这个案子还会被揭开吗？"
  }
]