[
  {
    "start": 0.6,
    "end": 2.2060556161218408,
    "text": "二零零三年九月，"
  },
  {
    "start": 2.4999742909676677,
    "end": 4.326468913223879,
    "text": "首尔江南区新沙洞，"
  },
  {
    "start": 4.515416632767625,
    "end": 6.803783458352993,
    "text": "一对老夫妇在自己家里遇害，"
  },
  {
    "start": 6.9507427957759065,
    "end": 8.462324552125875,
    "text": "房子随后被点着。"
  },
  {
    "start": 8.54630131636754,
    "end": 11.254551963161232,
    "text": "凶手没有拿走任何值钱的东西。"
  },
  {
    "start": 11.359522918463313,
    "end": 13.899820036773676,
    "text": "十个月后警方才确认，"
  },
  {
    "start": 14.130756138438255,
    "end": 15.621343703727806,
    "text": "那只是第一起；"
  },
  {
    "start": 15.915262378573633,
    "end": 17.34286737068194,
    "text": "而最后把他揪出来的，"
  },
  {
    "start": 17.65778023658818,
    "end": 18.581524643246492,
    "text": "不是指纹，"
  },
  {
    "start": 18.791466553850658,
    "end": 19.904158680052713,
    "text": "也不是监控，"
  },
  {
    "start": 20.15608897277771,
    "end": 23.011298956994317,
    "text": "是一部被记下来的电话号码。"
  },
  {
    "start": 24.374720536309937,
    "end": 25.550395235693244,
    "text": "他叫柳永哲，"
  },
  {
    "start": 25.655366190995327,
    "end": 29.119407715964005,
    "text": "一九七零年出生在全罗北道高敞郡，"
  },
  {
    "start": 29.234875766796293,
    "end": 30.337070797468144,
    "text": "家里很穷。"
  },
  {
    "start": 30.442041752770226,
    "end": 31.995611891241026,
    "text": "从高中时代起，"
  },
  {
    "start": 31.995611891241026,
    "end": 35.512138893860744,
    "text": "他就在监狱里进进出出："
  },
  {
    "start": 35.512138893860744,
    "end": 36.24693558097531,
    "text": "盗窃、"
  },
  {
    "start": 36.3624036318076,
    "end": 37.6535463820232,
    "text": "诈骗和暴力，"
  },
  {
    "start": 37.75851733732528,
    "end": 39.228110711554415,
    "text": "前后十四次，"
  },
  {
    "start": 39.33308166685649,
    "end": 40.65571570366272,
    "text": "累计服刑十一年。"
  },
  {
    "start": 40.72919537237418,
    "end": 43.353469254926196,
    "text": "二零零三年九月十一日，"
  },
  {
    "start": 43.4794344012887,
    "end": 45.84128089558553,
    "text": "他最后一次走出监狱；"
  },
  {
    "start": 45.84128089558553,
    "end": 48.35008672730526,
    "text": "妻子已经带着儿子离开，"
  },
  {
    "start": 48.46555477813755,
    "end": 49.83017719706461,
    "text": "那年他三十三岁。"
  },
  {
    "start": 50.910177197064606,
    "end": 51.676465170769795,
    "text": "出狱十三天后，"
  },
  {
    "start": 52.537227004246866,
    "end": 53.81787265893225,
    "text": "第一起案子发生了。"
  },
  {
    "start": 54.02781456953642,
    "end": 56.94600712693427,
    "text": "此后他专挑富人区的独栋住宅，"
  },
  {
    "start": 57.21893161071968,
    "end": 59.885193875392545,
    "text": "在白天老人独自在家的时候闯进去；"
  },
  {
    "start": 60.05314740387587,
    "end": 61.27081048538001,
    "text": "为了不留目击者，"
  },
  {
    "start": 61.37578144068209,
    "end": 63.3282412093008,
    "text": "连屋里的帮佣也不放过。"
  },
  {
    "start": 63.454206355663295,
    "end": 64.77684039246952,
    "text": "二零零四年春天，"
  },
  {
    "start": 65.00777649413409,
    "end": 66.51935825048406,
    "text": "他突然换了目标："
  },
  {
    "start": 66.51935825048406,
    "end": 68.95468441349234,
    "text": "用伪造的警察证件和一部电话，"
  },
  {
    "start": 69.08064955985485,
    "end": 71.93585954407145,
    "text": "把按摩女约到自己住的写字楼公寓。"
  },
  {
    "start": 72.08281888149436,
    "end": 73.44744130042142,
    "text": "到七月落网前，"
  },
  {
    "start": 73.51042387360266,
    "end": 76.17668613827553,
    "text": "有十一名女性走进了那栋楼，"
  },
  {
    "start": 76.17668613827553,
    "end": 77.20540150023592,
    "text": "再也没有出来。"
  },
  {
    "start": 78.49009486307497,
    "end": 79.27737702784059,
    "text": "一开始，"
  },
  {
    "start": 79.67626665798849,
    "end": 82.42650568690301,
    "text": "这些失踪并没有被当成连环案件。"
  },
  {
    "start": 82.59445921538634,
    "end": 85.5126517727842,
    "text": "按摩女的去向本来就少有人追问，"
  },
  {
    "start": 85.61762272808627,
    "end": 87.15019867549667,
    "text": "警方最初的判断是："
  },
  {
    "start": 87.27616382185916,
    "end": 89.5225422653237,
    "text": "可能有人把她们拐卖到了乡下。"
  },
  {
    "start": 89.6695016027466,
    "end": 94.33021201815902,
    "text": "真正的转机出现在一部电话上——店里好几个姑娘，"
  },
  {
    "start": 94.41418878240067,
    "end": 96.89150332752979,
    "text": "都是接到同一个号码之后消失的。"
  },
  {
    "start": 97.08045104707354,
    "end": 98.82296890508808,
    "text": "老板把号码记了下来，"
  },
  {
    "start": 98.969928242511,
    "end": 100.20858551507555,
    "text": "又看见它出现，"
  },
  {
    "start": 100.41852742567971,
    "end": 101.74116146248593,
    "text": "就带着人报了警。"
  },
  {
    "start": 103.12032868509687,
    "end": 105.58714613469577,
    "text": "二零零四年七月十五日凌晨，"
  },
  {
    "start": 105.81808223636035,
    "end": 108.94621670436237,
    "text": "警方在麻浦区的一条巷子里抓住了他。"
  },
  {
    "start": 109.13516442390612,
    "end": 112.26329889190814,
    "text": "审讯中途他假装癫痫发作，"
  },
  {
    "start": 112.51522918463313,
    "end": 114.92956115658099,
    "text": "趁手铐松开逃出警局；"
  },
  {
    "start": 115.2024856403664,
    "end": 116.31517776656847,
    "text": "十二个小时后，"
  },
  {
    "start": 116.5041254861122,
    "end": 120.07313796638296,
    "text": "警察在永登浦站附近把他重新抓住。"
  },
  {
    "start": 120.28307987698713,
    "end": 122.17255707242458,
    "text": "面对警方的问话，"
  },
  {
    "start": 122.27752802772667,
    "end": 125.6785869795141,
    "text": "他承认自己和这些失踪案有关。"
  },
  {
    "start": 125.76256374375576,
    "end": 127.00122101632032,
    "text": "七月十八日，"
  },
  {
    "start": 127.06420358950156,
    "end": 130.40227996810773,
    "text": "他带着警察上了奉元寺的后山。"
  },
  {
    "start": 130.80116959825565,
    "end": 131.80889076915562,
    "text": "雨天里，"
  },
  {
    "start": 131.9978384886994,
    "end": 134.097257594741,
    "text": "警方在那片山坡上，"
  },
  {
    "start": 134.097257594741,
    "end": 137.43533397334718,
    "text": "找到了十一名失踪女性的下落。"
  },
  {
    "start": 138.69826773191008,
    "end": 141.0391200351465,
    "text": "二零零四年十二月十三日，"
  },
  {
    "start": 141.14409099044857,
    "end": 143.13853914118812,
    "text": "首尔中央地方法院认定，"
  },
  {
    "start": 143.25400719202042,
    "end": 145.78380721480056,
    "text": "他对二十人的死亡负有责任，"
  },
  {
    "start": 145.78380721480056,
    "end": 146.92799062759326,
    "text": "判处死刑；"
  },
  {
    "start": 147.03296158289533,
    "end": 148.50255495712446,
    "text": "二零零五年六月，"
  },
  {
    "start": 148.60752591242655,
    "end": 151.21080560391817,
    "text": "最高法院终审维持原判。"
  },
  {
    "start": 151.31577655922024,
    "end": 155.03174837691392,
    "text": "韩国从一九九七年起就没有再执行过死刑，"
  },
  {
    "start": 155.10522804562538,
    "end": 157.204647151667,
    "text": "他至今仍然在监狱里。"
  },
  {
    "start": 157.30961810696908,
    "end": 158.94716500968153,
    "text": "真正让人不安的是，"
  },
  {
    "start": 158.96815920074195,
    "end": 160.04936004035338,
    "text": "他被捕之后，"
  },
  {
    "start": 160.1753251867159,
    "end": 163.36644222789914,
    "text": "韩国的网站上出现了他的粉丝俱乐部。"
  },
  {
    "start": 163.48191027873145,
    "end": 164.7310646468262,
    "text": "二零零八年，"
  },
  {
    "start": 164.7310646468262,
    "end": 167.46030948468032,
    "text": "这起案子被拍成电影《追击者》；"
  },
  {
    "start": 167.5652804399824,
    "end": 168.63598418406363,
    "text": "二零二一年，"
  },
  {
    "start": 168.63598418406363,
    "end": 170.10557755829277,
    "text": "它又被拍成纪录片。"
  },
  {
    "start": 170.22104560912504,
    "end": 172.44642986152917,
    "text": "危险从不写在脸上，"
  },
  {
    "start": 172.56189791236145,
    "end": 173.99999999999997,
    "text": "它就走在人群里。"
  }
]